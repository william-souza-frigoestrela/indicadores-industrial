expression 'Aux Compra' = ```
		let
		    // 1. Conexão SQL nativa no Oracle unificando os dados de Abate por filial com NROEMPRESA fixo
		    Fonte = Oracle.Database("datavale", [
		        HierarchicalNavigation = true, 
		        Query = "
		            SELECT 
		                2 AS NROEMPRESA, 
		                e.* 
		            FROM DINVPB_ABATE@dtvind02 e 
		            WHERE DATA >= '01-JAN-2026'
		
		            UNION ALL
		
		            SELECT 
		                4 AS NROEMPRESA, 
		                e.* 
		            FROM DINVPB_ABATE@dtvind04 e 
		            WHERE DATA >= '01-JAN-2026'
		
		            UNION ALL
		
		            SELECT 
		                104 AS NROEMPRESA, 
		                e.* 
		            FROM DINVPB_ABATE@dtvind104 e 
		            WHERE DATA >= '01-JAN-2026'
		
		            UNION ALL
		
		            SELECT 
		                12 AS NROEMPRESA, 
		                e.* 
		            FROM DINVPB_ABATE@dtvind12 e 
		            WHERE DATA >= '01-JAN-2026'
		        "
		    ]),
		
		    // 2. Tipagem das colunas
		    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte, {
		        {"NROEMPRESA", Int64.Type}, 
		        {"DATA", type date}, 
		        {"HR", type time}, 
		        {"SEQUENCIADIA", Int64.Type}, 
		        {"SEQPRODUTO", Int64.Type}, 
		        {"DESCRPRODUTO", type text}, 
		        {"BANDA", type text}, 
		        {"PESOLIQUIDO", type number}, 
		        {"PESOLIQUIDOQUEBRA", type number}, 
		        {"SEXO", type text}, 
		        {"DESCRSEXO", type text}, 
		        {"DESCRREDCLASSIFICACAO", type text}, 
		        {"DESCRCLASSIFICACAO", type text}, 
		        {"SEQCLASSIFABATE", Int64.Type}, 
		        {"DESCRCLASSIFABATE", type text}, 
		        {"DESCRCLASSIFACABAMENTO", type text}, 
		        {"DESCRREDCLASSIFABATE", type text}, 
		        {"SEQCLASSIFMATURIDADE", Int64.Type}, 
		        {"DESCRCLASSIFMATURIDADE", type text}, 
		        {"DESCRREDCLASSIFMATURIDADE", Int64.Type}, 
		        {"SEQCLASSIFRACA", Int64.Type}, 
		        {"DESCRCLASSIFRACA", type text}, 
		        {"SEQCLASSIFCONFORMIDADE", Int64.Type}, 
		        {"DESCRCLASSIFCONFORMIDADE", type text}, 
		        {"DESCRREDCLASSIFCONFORMIDADE", type text}, 
		        {"ASPERSAO", type text}, 
		        {"CONFORME", type text}, 
		        {"NROPEDIDO", Int64.Type}, 
		        {"NROLOTE", Int64.Type}, 
		        {"SEQVENDEDOR", Int64.Type}, 
		        {"SEQPESSOA", Int64.Type}, 
		        {"NOMEPESSOA", type text}, 
		        {"NOMEPROPRIEDADE", type text}, 
		        {"CIDADEPROPRIEDADE", type text}, 
		        {"UFPROPRIEDADE", type text}, 
		        {"GRUPOPROD", Int64.Type}, 
		        {"SUBGRUPOPROD", Int64.Type}, 
		        {"FAMILIAPROD", Int64.Type}
		    }),
		
		    // 3. Seleção das colunas necessárias
		    #"Outras Colunas Removidas" = Table.SelectColumns(#"Tipo Alterado", {"NROEMPRESA", "DATA", "NROPEDIDO"}),
		
		    // 4. Remoção de duplicatas
		    #"Duplicatas Removidas" = Table.Distinct(#"Outras Colunas Removidas"),
		
		    // 5. Criação da coluna Mesclado (NROEMPRESA + NROPEDIDO)
		    #"Coluna Mesclada Inserida" = Table.AddColumn(#"Duplicatas Removidas", "Mesclado", each Text.Combine({Text.From([NROEMPRESA], "pt-BR"), Text.From([NROPEDIDO], "pt-BR")}, ""), type text)
		in
		    #"Coluna Mesclada Inserida"
