expression 'Classificação Aux' = ```
		let
		    Fonte = PowerPlatform.Dataflows(null),
		    Workspaces = Fonte{[Id="Workspaces"]}[Data],
		    #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8" = Workspaces{[workspaceId="d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"]}[Data],
		    #"35024cdc-6a08-4e80-8a93-36e024176d14" = #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"{[dataflowId="35024cdc-6a08-4e80-8a93-36e024176d14"]}[Data],
		
		    // Importando as quatro entidades
		    AbateMTZ = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATE_MTZ", version=""]}[Data],
		    AbateRND = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATE_RND", version=""]}[Data],
		    AbateSLG = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATE_SLG", version=""]}[Data],
		    AbateTUP = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATE_TUP", version=""]}[Data],
		
		    // Selecionando apenas as colunas desejadas e combinando
		    AbateMTZ_sel = Table.SelectColumns(AbateMTZ, {"DESCRREDCLASSIFCONFORMIDADE", "DESCRCLASSIFCONFORMIDADE"}),
		    AbateRND_sel = Table.SelectColumns(AbateRND, {"DESCRREDCLASSIFCONFORMIDADE", "DESCRCLASSIFCONFORMIDADE"}),
		    AbateSLG_sel = Table.SelectColumns(AbateSLG, {"DESCRREDCLASSIFCONFORMIDADE", "DESCRCLASSIFCONFORMIDADE"}),
		    AbateTUP_sel = Table.SelectColumns(AbateTUP, {"DESCRREDCLASSIFCONFORMIDADE", "DESCRCLASSIFCONFORMIDADE"}),
		
		    DadosCombinados = Table.Combine({AbateMTZ_sel, AbateRND_sel, AbateSLG_sel, AbateTUP_sel}),
		    #"Duplicatas Removidas" = Table.Distinct(DadosCombinados),
		
		    // Adicionando as colunas condicionais
		    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Duplicatas Removidas", "CLASSIFICAÇÃO", each 
		        if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "CHN") then "MERCADO EXTERNO" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "MB") then "MERCADO EXTERNO" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "UE") then "MERCADO EXTERNO" 
		        else "MERCADO INTERNO"),
		
		    #"Coluna Condicional Adicionada1" = Table.AddColumn(#"Coluna Condicional Adicionada", "CLASSIFICACAORED", each 
		        if [DESCRREDCLASSIFCONFORMIDADE] = "UE/CHN" then "01. UE/CHN" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "CHN") then "02. CHN" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "MB") then "02. CHN" 
		        else if [DESCRREDCLASSIFCONFORMIDADE] = "UE" then "01. UE" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "LG") then "03. LG/LE" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "LE") then "03. LG/LE" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "NE") then "NE" 
		        else if Text.Contains([DESCRREDCLASSIFCONFORMIDADE], "RA") then "03. LG/LE" 
		        else [DESCRREDCLASSIFCONFORMIDADE]),
		
		    #"Tipo Alterado" = Table.TransformColumnTypes(#"Coluna Condicional Adicionada1",{
		        {"DESCRREDCLASSIFCONFORMIDADE", type text}, 
		        {"DESCRCLASSIFCONFORMIDADE", type text}, 
		        {"CLASSIFICAÇÃO", type text}, 
		        {"CLASSIFICACAORED", type text}
		    })
		in
		    #"Tipo Alterado"
		```
	lineageTag: 9ba6b4db-986a-49ca-93b1-961130bf0241
	queryGroup: 'Fluxo Industrial'

