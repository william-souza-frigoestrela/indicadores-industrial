expression DINVPB_ABATEPAUSA =
		let
		    Fonte = PowerPlatform.Dataflows(null),
		    Workspaces = Fonte{[Id="Workspaces"]}[Data],
		    #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8" = Workspaces{[workspaceId="d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"]}[Data],
		    #"35024cdc-6a08-4e80-8a93-36e024176d14" = #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"{[dataflowId="35024cdc-6a08-4e80-8a93-36e024176d14"]}[Data],
		
		    // Carregar e transformar cada tabela
		    TransformarTabela = (tabela as table, nomeUnidade as text) =>
		        let
		            TipoAlterado = Table.TransformColumnTypes(tabela, {
		                {"DATAINICIAL", type date}, {"HORAINICIAL", Int64.Type},
		                {"DATAFINAL", type date}, {"HORAFINAL", Int64.Type},
		                {"MOTIVO", type text}, {"HRINICIAL", type time},
		                {"HRFINAL", type time}, {"NROEMPRESA", Int64.Type}
		            }),
		            DataHoraInicial = Table.AddColumn(TipoAlterado, "INICIAL", each [DATAINICIAL] & [HRINICIAL], type datetime),
		            DataHoraFinal = Table.AddColumn(DataHoraInicial, "FINAL", each [DATAFINAL] & [HRFINAL], type datetime),
		            ColunasRemovidas = Table.RemoveColumns(DataHoraFinal, {"DATAINICIAL", "HORAINICIAL", "DATAFINAL", "HORAFINAL", "HRINICIAL", "HRFINAL"}),
		            ColunasRenomeadas = Table.RenameColumns(ColunasRemovidas, {{"INICIAL", "DTAHORAINICIAL"}, {"FINAL", "DTAHORAFINAL"}}),
		            ColunaTipo = Table.AddColumn(ColunasRenomeadas, "TIPO", each "ABATE", type text),
		            ColunaUnidade = Table.AddColumn(ColunaTipo, "UNIDADE", each nomeUnidade, type text),
		            TiposFinais = Table.TransformColumnTypes(ColunaUnidade, {
		                {"MOTIVO", type text}, {"NROEMPRESA", Int64.Type},
		                {"DTAHORAINICIAL", type datetime}, {"DTAHORAFINAL", type datetime},
		                {"TIPO", type text}, {"UNIDADE", type text}
		            })
		        in
		            TiposFinais,
		
		    // Carregar os dados brutos
		    Tabela_MTZ = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATEPAUSA_MTZ", version=""]}[Data],
		    Tabela_RND = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATEPAUSA_RND", version=""]}[Data],
		    Tabela_SLG = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATEPAUSA_SLG", version=""]}[Data],
		    Tabela_TUP = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_ABATEPAUSA_TUP", version=""]}[Data],
		
		    // Aplicar transformações
		    Transformada_MTZ = TransformarTabela(Tabela_MTZ, "MTZ"),
		    Transformada_RND = TransformarTabela(Tabela_RND, "RND"),
		    Transformada_SLG = TransformarTabela(Tabela_SLG, "SLG"),
		    Transformada_TUP = TransformarTabela(Tabela_TUP, "TUP"),
		
		    // Combinar todas
		    TabelaUnificada = Table.Combine({
		        Transformada_MTZ,
		        Transformada_RND,
		        Transformada_SLG,
		        Transformada_TUP
		    })
		in
		    TabelaUnificada
	lineageTag: fec40ee5-89ba-4b7d-901a-3fa5028b4fe7
	queryGroup: 'Fluxo Industrial'

