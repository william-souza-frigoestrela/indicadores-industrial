expression DINVPB_PAUSADESOSSA = ```
		let
		    // 1. Conexão SQL nativa unificando as instâncias de Pausa de Desossa no Oracle com NROEMPRESA fixo
		    Fonte = Oracle.Database("datavale", [HierarchicalNavigation=true, Query="#(lf)            SELECT #(lf)                2 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_PAUSADESOSSA@dtvind02 e #(lf)            --WHERE DTAHORAINICIAL >= TRUNC(SYSDATE)-90#(lf)--WHERE DTAHORAINICIAL >= '01-jan-2026'#(lf)            #(lf)            UNION ALL#(lf)            #(lf)            SELECT #(lf)                4 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_PAUSADESOSSA@dtvind04 e #(lf)            --WHERE DTAHORAINICIAL >= TRUNC(SYSDATE)-90#(lf)--WHERE DTAHORAINICIAL >= '01-jan-2026'#(lf)            #(lf)            UNION ALL#(lf)            #(lf)            SELECT #(lf)                104 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_PAUSADESOSSA@dtvind104 e #(lf)            --WHERE DTAHORAINICIAL >= TRUNC(SYSDATE)-90#(lf)--WHERE DTAHORAINICIAL >= '01-jan-2026'#(lf)        "]),
		
		    // 2. Remove colunas indesejadas
		    #"Colunas Removidas" = Table.RemoveColumns(Fonte, {"SEQPAUSA", "SEQPONTO", "TIPO", "DESCRICAO", "Hora"}, MissingField.Ignore),
		
		    // 3. Adiciona coluna TIPO com valor fixo "DESOSSA"
		    #"Personalização Adicionada" = Table.AddColumn(#"Colunas Removidas", "TIPO", each "DESOSSA", type text),
		
		    // 4. Altera tipos de dados finais
		    #"Tipo Alterado" = Table.TransformColumnTypes(#"Personalização Adicionada", {
		        {"DTAHORAINICIAL", type datetime}, 
		        {"DTAHORAFINAL", type datetime}, 
		        {"MOTIVO", type text}, 
		        {"NROEMPRESA", Int64.Type}, 
		        {"TIPO", type text}
		    })
		in
		    #"Tipo Alterado"
		```
