expression DINVPB_ABATEPAUSA = ```
		let
		    // 1. Conexão SQL nativa unificando as instâncias de Pausa de Abate no Oracle
		    Fonte = Oracle.Database("datavale", [
		        HierarchicalNavigation = true, 
		        Query = "
		            SELECT 
		                2 AS NROEMPRESA,
		                DATAINICIAL, 
		                HORAINICIAL, 
		                DATAFINAL, 
		                HORAFINAL, 
		                MOTIVO,
		                SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),5,2) AS HRINICIAL,
		                SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),5,2) AS HRFINAL
		            FROM DIN_ABATEPAUSA@dtvind02 
		            WHERE DATAINICIAL >= '01-JAN-2026'
		
		            UNION ALL
		
		            SELECT 
		                4 AS NROEMPRESA,
		                DATAINICIAL, 
		                HORAINICIAL, 
		                DATAFINAL, 
		                HORAFINAL, 
		                MOTIVO,
		                SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),5,2) AS HRINICIAL,
		                SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),5,2) AS HRFINAL
		            FROM DIN_ABATEPAUSA@dtvind04 
		            WHERE DATAINICIAL >= '01-JAN-2026'
		
		            UNION ALL
		
		            SELECT 
		                104 AS NROEMPRESA,
		                DATAINICIAL, 
		                HORAINICIAL, 
		                DATAFINAL, 
		                HORAFINAL, 
		                MOTIVO,
		                SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),5,2) AS HRINICIAL,
		                SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),5,2) AS HRFINAL
		            FROM DIN_ABATEPAUSA@dtvind104 
		            WHERE DATAINICIAL >= '01-JAN-2026'
		
		            UNION ALL
		
		            SELECT 
		                12 AS NROEMPRESA,
		                DATAINICIAL, 
		                HORAINICIAL, 
		                DATAFINAL, 
		                HORAFINAL, 
		                MOTIVO,
		                SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAINICIAL,'000000')),5,2) AS HRINICIAL,
		                SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),1,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),3,2) || ':' || SUBSTR(TRIM(TO_CHAR(HORAFINAL,'000000')),5,2) AS HRFINAL
		            FROM DIN_ABATEPAUSA@dtvind12 
		            WHERE DATAINICIAL >= '01-JAN-2026'
		        "
		    ]),
		
		    // 2. Garantia de tipagem inicial para operações de data/hora
		    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte, {
		        {"DATAINICIAL", type date}, 
		        {"HORAINICIAL", Int64.Type},
		        {"DATAFINAL", type date}, 
		        {"HORAFINAL", Int64.Type},
		        {"MOTIVO", type text}, 
		        {"HRINICIAL", type time},
		        {"HRFINAL", type time}, 
		        {"NROEMPRESA", Int64.Type}
		    }),
		
		    // 3. Montagem dos campos datetime combinando Data + Hora
		    DataHoraInicial = Table.AddColumn(#"Tipo Alterado", "INICIAL", each [DATAINICIAL] & [HRINICIAL], type datetime),
		    DataHoraFinal = Table.AddColumn(DataHoraInicial, "FINAL", each [DATAFINAL] & [HRFINAL], type datetime),
		    
		    // 4. Limpeza de colunas auxiliares e renomeações
		    ColunasRemovidas = Table.RemoveColumns(DataHoraFinal, {"DATAINICIAL", "HORAINICIAL", "DATAFINAL", "HORAFINAL", "HRINICIAL", "HRFINAL"}),
		    ColunasRenomeadas = Table.RenameColumns(ColunasRemovidas, {{"INICIAL", "DTAHORAINICIAL"}, {"FINAL", "DTAHORAFINAL"}}),
		    
		    // 5. Adição das colunas TIPO e UNIDADE condicional
		    ColunaTipo = Table.AddColumn(ColunasRenomeadas, "TIPO", each "ABATE", type text),
		    ColunaUnidade = Table.AddColumn(ColunaTipo, "UNIDADE", each 
		        if [NROEMPRESA] = 2 then "MTZ" 
		        else if [NROEMPRESA] = 4 then "RND" 
		        else if [NROEMPRESA] = 104 then "SLG" 
		        else if [NROEMPRESA] = 12 then "TUP" 
		        else null, 
		        type text
		    ),
		
		    // 6. Tipagem final
		    TiposFinais = Table.TransformColumnTypes(ColunaUnidade, {
		        {"MOTIVO", type text}, 
		        {"NROEMPRESA", Int64.Type},
		        {"DTAHORAINICIAL", type datetime}, 
		        {"DTAHORAFINAL", type datetime},
		        {"TIPO", type text}, 
		        {"UNIDADE", type text}
		    })
		in
		    TiposFinais
		```
	lineageTag: fec40ee5-89ba-4b7d-901a-3fa5028b4fe7
	queryGroup: 'Fluxo Industrial'

