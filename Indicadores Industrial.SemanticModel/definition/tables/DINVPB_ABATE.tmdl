	partition DINVPB_ABATE-015b6fe3-14d3-4263-8b79-ed9f3ce91f0c = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source = ```
				let
				    Fonte = Oracle.Database("datavale", [HierarchicalNavigation=true, Query="#(lf)        SELECT e.NROEMPRESA,#(tab)e.DATA,#(tab)e.HR,#(tab)e.SEQUENCIADIA,#(tab)e.SEQPRODUTO,#(tab)e.DESCRPRODUTO,#(tab)e.BANDA,#(tab)e.PESOLIQUIDO,#(tab)e.PESOLIQUIDOQUEBRA,#(tab)e.SEXO,#(tab)e.DESCRSEXO,#(tab)e.DESCRREDCLASSIFICACAO,#(tab)e.DESCRCLASSIFICACAO,#(tab)e.SEQCLASSIFABATE,#(tab)e.DESCRCLASSIFABATE,#(tab)e.DESCRCLASSIFACABAMENTO,#(tab)e.DESCRREDCLASSIFABATE,#(tab)e.SEQCLASSIFMATURIDADE,#(tab)e.DESCRCLASSIFMATURIDADE,#(tab)e.DESCRREDCLASSIFMATURIDADE,#(tab)e.SEQCLASSIFRACA,#(tab)e.DESCRCLASSIFRACA,#(tab)e.SEQCLASSIFCONFORMIDADE,#(tab)e.DESCRCLASSIFCONFORMIDADE,#(tab)e.DESCRREDCLASSIFCONFORMIDADE,#(tab)e.ASPERSAO,#(tab)e.CONFORME,#(tab)e.NROPEDIDO,#(tab)e.NROLOTE,#(tab)e.SEQVENDEDOR,#(tab)e.SEQPESSOA,#(tab)e.NOMEPESSOA,#(tab)e.NOMEPROPRIEDADE,#(tab)e.CIDADEPROPRIEDADE,#(tab)e.UFPROPRIEDADE,#(tab)e.GRUPOPROD,#(tab)e.SUBGRUPOPROD,#(tab)e.FAMILIAPROD#(lf) FROM DINVPB_ABATE@dtvind02 e WHERE DATA>= '01-jan-2026'#(lf)        UNION ALL#(lf)        SELECT e.NROEMPRESA,#(tab)e.DATA,#(tab)e.HR,#(tab)e.SEQUENCIADIA,#(tab)e.SEQPRODUTO,#(tab)e.DESCRPRODUTO,#(tab)e.BANDA,#(tab)e.PESOLIQUIDO,#(tab)e.PESOLIQUIDOQUEBRA,#(tab)e.SEXO,#(tab)e.DESCRSEXO,#(tab)e.DESCRREDCLASSIFICACAO,#(tab)e.DESCRCLASSIFICACAO,#(tab)e.SEQCLASSIFABATE,#(tab)e.DESCRCLASSIFABATE,#(tab)e.DESCRCLASSIFACABAMENTO,#(tab)e.DESCRREDCLASSIFABATE,#(tab)e.SEQCLASSIFMATURIDADE,#(tab)e.DESCRCLASSIFMATURIDADE,#(tab)e.DESCRREDCLASSIFMATURIDADE,#(tab)e.SEQCLASSIFRACA,#(tab)e.DESCRCLASSIFRACA,#(tab)e.SEQCLASSIFCONFORMIDADE,#(tab)e.DESCRCLASSIFCONFORMIDADE,#(tab)e.DESCRREDCLASSIFCONFORMIDADE,#(tab)e.ASPERSAO,#(tab)e.CONFORME,#(tab)e.NROPEDIDO,#(tab)e.NROLOTE,#(tab)e.SEQVENDEDOR,#(tab)e.SEQPESSOA,#(tab)e.NOMEPESSOA,#(tab)e.NOMEPROPRIEDADE,#(tab)e.CIDADEPROPRIEDADE,#(tab)e.UFPROPRIEDADE,#(tab)e.GRUPOPROD,#(tab)e.SUBGRUPOPROD,#(tab)e.FAMILIAPROD#(lf) FROM DINVPB_ABATE@dtvind04 e WHERE DATA>= '01-jan-2026'#(lf)        UNION ALL#(lf)        SELECT e.NROEMPRESA,#(tab)e.DATA,#(tab)e.HR,#(tab)e.SEQUENCIADIA,#(tab)e.SEQPRODUTO,#(tab)e.DESCRPRODUTO,#(tab)e.BANDA,#(tab)e.PESOLIQUIDO,#(tab)e.PESOLIQUIDOQUEBRA,#(tab)e.SEXO,#(tab)e.DESCRSEXO,#(tab)e.DESCRREDCLASSIFICACAO,#(tab)e.DESCRCLASSIFICACAO,#(tab)e.SEQCLASSIFABATE,#(tab)e.DESCRCLASSIFABATE,#(tab)e.DESCRCLASSIFACABAMENTO,#(tab)e.DESCRREDCLASSIFABATE,#(tab)e.SEQCLASSIFMATURIDADE,#(tab)e.DESCRCLASSIFMATURIDADE,#(tab)e.DESCRREDCLASSIFMATURIDADE,#(tab)e.SEQCLASSIFRACA,#(tab)e.DESCRCLASSIFRACA,#(tab)e.SEQCLASSIFCONFORMIDADE,#(tab)e.DESCRCLASSIFCONFORMIDADE,#(tab)e.DESCRREDCLASSIFCONFORMIDADE,#(tab)e.ASPERSAO,#(tab)e.CONFORME,#(tab)e.NROPEDIDO,#(tab)e.NROLOTE,#(tab)e.SEQVENDEDOR,#(tab)e.SEQPESSOA,#(tab)e.NOMEPESSOA,#(tab)e.NOMEPROPRIEDADE,#(tab)e.CIDADEPROPRIEDADE,#(tab)e.UFPROPRIEDADE,#(tab)e.GRUPOPROD,#(tab)e.SUBGRUPOPROD,#(tab)e.FAMILIAPROD#(lf) FROM DINVPB_ABATE@dtvind12 e WHERE DATA>= '01-jan-2026'#(lf)        UNION ALL#(lf)        SELECT e.NROEMPRESA,#(tab)e.DATA,#(tab)e.HR,#(tab)e.SEQUENCIADIA,#(tab)e.SEQPRODUTO,#(tab)e.DESCRPRODUTO,#(tab)e.BANDA,#(tab)e.PESOLIQUIDO,#(tab)e.PESOLIQUIDOQUEBRA,#(tab)e.SEXO,#(tab)e.DESCRSEXO,#(tab)e.DESCRREDCLASSIFICACAO,#(tab)e.DESCRCLASSIFICACAO,#(tab)e.SEQCLASSIFABATE,#(tab)e.DESCRCLASSIFABATE,#(tab)e.DESCRCLASSIFACABAMENTO,#(tab)e.DESCRREDCLASSIFABATE,#(tab)e.SEQCLASSIFMATURIDADE,#(tab)e.DESCRCLASSIFMATURIDADE,#(tab)e.DESCRREDCLASSIFMATURIDADE,#(tab)e.SEQCLASSIFRACA,#(tab)e.DESCRCLASSIFRACA,#(tab)e.SEQCLASSIFCONFORMIDADE,#(tab)e.DESCRCLASSIFCONFORMIDADE,#(tab)e.DESCRREDCLASSIFCONFORMIDADE,#(tab)e.ASPERSAO,#(tab)e.CONFORME,#(tab)e.NROPEDIDO,#(tab)e.NROLOTE,#(tab)e.SEQVENDEDOR,#(tab)e.SEQPESSOA,#(tab)e.NOMEPESSOA,#(tab)e.NOMEPROPRIEDADE,#(tab)e.CIDADEPROPRIEDADE,#(tab)e.UFPROPRIEDADE,#(tab)e.GRUPOPROD,#(tab)e.SUBGRUPOPROD,#(tab)e.FAMILIAPROD#(lf) FROM DINVPB_ABATE@dtvind104 e WHERE DATA>= '01-jan-2026'#(lf)    "]),
				
				
				    // Resto do processamento
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte, {
				        {"NROEMPRESA", Int64.Type}, {"DATA", type date}, {"HR", type time}, {"SEQUENCIADIA", Int64.Type},
				        {"SEQPRODUTO", Int64.Type}, {"DESCRPRODUTO", type text}, {"BANDA", type text}, {"PESOLIQUIDO", type number},
				        {"PESOLIQUIDOQUEBRA", type number}, {"SEXO", type text}, {"DESCRSEXO", type text}, {"DESCRREDCLASSIFICACAO", type text},
				        {"DESCRCLASSIFICACAO", type text}, {"SEQCLASSIFABATE", Int64.Type}, {"DESCRCLASSIFABATE", type text},
				        {"DESCRCLASSIFACABAMENTO", type text}, {"DESCRREDCLASSIFABATE", type text}, {"SEQCLASSIFMATURIDADE", Int64.Type},
				        {"DESCRCLASSIFMATURIDADE", type text}, {"DESCRREDCLASSIFMATURIDADE", Int64.Type}, {"SEQCLASSIFRACA", Int64.Type},
				        {"DESCRCLASSIFRACA", type text}, {"SEQCLASSIFCONFORMIDADE", Int64.Type}, {"DESCRCLASSIFCONFORMIDADE", type text},
				        {"DESCRREDCLASSIFCONFORMIDADE", type text}, {"ASPERSAO", type text}, {"CONFORME", type text},
				        {"NROPEDIDO", Int64.Type}, {"NROLOTE", Int64.Type}, {"SEQVENDEDOR", Int64.Type}, {"SEQPESSOA", Int64.Type},
				        {"NOMEPESSOA", type text}, {"NOMEPROPRIEDADE", type text}, {"CIDADEPROPRIEDADE", type text},
				        {"UFPROPRIEDADE", type text}, {"GRUPOPROD", Int64.Type}, {"SUBGRUPOPROD", Int64.Type}, {"FAMILIAPROD", Int64.Type}
				    }),
				    #"Data e Hora Mescladas Inseridas" = Table.AddColumn(#"Tipo Alterado", "Data e Hora", each [DATA] & [HR], type datetime),
				    #"Consultas Mescladas" = Table.NestedJoin(#"Data e Hora Mescladas Inseridas", {"DESCRREDCLASSIFCONFORMIDADE"}, #"Classificação Aux", {"DESCRREDCLASSIFCONFORMIDADE"}, "Classificação Aux", JoinKind.LeftOuter),
				    #"Classificação Aux Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "Classificação Aux", {"CLASSIFICAÇÃO", "CLASSIFICACAORED"}, {"CLASSIFICAÇÃO", "CLASSIFICACAORED"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Classificação Aux Expandido", {
				        {"NROEMPRESA", Int64.Type}, {"DATA", type date}, {"HR", type time}, {"SEQUENCIADIA", Int64.Type},
				        {"SEQPRODUTO", Int64.Type}, {"DESCRPRODUTO", type text}, {"BANDA", type text}, {"PESOLIQUIDO", type number},
				        {"PESOLIQUIDOQUEBRA", type number}, {"SEXO", type text}, {"DESCRSEXO", type text}, {"DESCRREDCLASSIFICACAO", type text},
				        {"DESCRCLASSIFICACAO", type text}, {"SEQCLASSIFABATE", Int64.Type}, {"DESCRCLASSIFABATE", type text},
				        {"DESCRCLASSIFACABAMENTO", type text}, {"DESCRREDCLASSIFABATE", type text}, {"SEQCLASSIFMATURIDADE", Int64.Type},
				        {"DESCRCLASSIFMATURIDADE", type text}, {"DESCRREDCLASSIFMATURIDADE", Int64.Type}, {"SEQCLASSIFRACA", Int64.Type},
				        {"DESCRCLASSIFRACA", type text}, {"SEQCLASSIFCONFORMIDADE", Int64.Type}, {"DESCRCLASSIFCONFORMIDADE", type text},
				        {"DESCRREDCLASSIFCONFORMIDADE", type text}, {"ASPERSAO", type text}, {"CONFORME", type text},
				        {"NROPEDIDO", Int64.Type}, {"NROLOTE", Int64.Type}, {"SEQVENDEDOR", Int64.Type}, {"SEQPESSOA", Int64.Type},
				        {"NOMEPESSOA", type text}, {"NOMEPROPRIEDADE", type text}, {"CIDADEPROPRIEDADE", type text},
				        {"UFPROPRIEDADE", type text}, {"GRUPOPROD", Int64.Type}, {"SUBGRUPOPROD", Int64.Type},
				        {"FAMILIAPROD", Int64.Type}, {"Data e Hora", type datetime}, {"CLASSIFICAÇÃO", type text}
				    }),
				    #"Duplicatas Removidas" = Table.Distinct(#"Tipo Alterado1"),
				    #"Columns removed by Measure Killer"= Table.SelectColumns(#"Duplicatas Removidas",{"DESCRSEXO","CLASSIFICAÇÃO","PESOLIQUIDO","NROEMPRESA","DATA","DESCRREDCLASSIFCONFORMIDADE","DESCRREDCLASSIFABATE","NROPEDIDO","Data e Hora","SEQPESSOA","CLASSIFICACAORED"}),
				
				// 1. Ajuste o nome #"Etapa Anterior" para o nome da última etapa do seu Power Query
				    FonteDados = #"Columns removed by Measure Killer",
				
				    // 2. Garante tipagem correta de Data/Hora e Empresa para evitar erros nas comparações
				    #"Tipos Garantidos" = Table.TransformColumnTypes(FonteDados, {
				        {"Data e Hora", type datetime},
				        {"DATA", type date},
				        {"NROEMPRESA", Int64.Type},
				        {"DESCRSEXO", type text}
				    }),
				
				    // 3. Tradução do 'Turno' (DAX) para Power Query (M)
				    // Extrai o componente de horário Time.From([Data e Hora]) para validar a janela das 04:00:00 às 15:59:59
				    #"Coluna Turno Adicionada" = Table.AddColumn(#"Tipos Garantidos", "Turno", each 
				        if [NROEMPRESA] = 4 or [NROEMPRESA] = 12 or [NROEMPRESA] = 104 then 
				            "Diurno"
				        else if Time.From([Data e Hora]) >= #time(4, 0, 0) and Time.From([Data e Hora]) <= #time(15, 59, 59) then 
				            "Diurno"
				        else 
				            "Noturno", 
				        type text
				    ),
				
				    // 4. Tradução da coluna _Sexo para M
				    #"Coluna _Sexo Adicionada" = Table.AddColumn(#"Coluna Turno Adicionada", "_Sexo", each 
				        if [NROEMPRESA] = 2 or [NROEMPRESA] = 12 then 
				            if [DESCRSEXO] = "Macho Inteiro" or [DESCRSEXO] = "Macho Castrado" then "Macho" else [DESCRSEXO]
				        else if [NROEMPRESA] = 4 or [NROEMPRESA] = 104 then 
				            "Suino" 
				        else 
				            [DESCRSEXO], 
				        type text
				    ),
				
				    // 5. Criação da coluna auxiliar de horário para a _HoraMin (>= 04:00:00)
				    //#"DataHora Filtro Mínimo" = Table.AddColumn(#"Coluna _Sexo Adicionada", "_DataHoraParaMin", each 
				    //    if Time.From([Data e Hora]) >= #time(4, 0, 0) then [Data e Hora] else null, 
				    //    type datetime
				    //),
				
				    // 6. Agrupamento equivalente ao ALLEXCEPT(DINVPB_ABATE, DATA, NROEMPRESA, Turno)
				    //#"Tabela Agrupada" = Table.Group(#"DataHora Filtro Mínimo", {"DATA", "NROEMPRESA", "Turno"}, {
				    //    {"_HoraMax", each List.Max([Data e Hora]), type datetime},
				    //    {"_HoraMin", each List.Min([_DataHoraParaMin]), type datetime},
				    //    {"_Contar Linhas", each Table.RowCount(_), type number}
				    //}),
				
				    
				
				 // 5. Coluna auxiliar para _HoraMin (somente horas >= 04:00)
				    #"DataHora Filtro Mínimo" = Table.AddColumn(
				        #"Coluna _Sexo Adicionada",
				        "_DataHoraParaMin",
				        each
				            if Time.From([Data e Hora]) >= #time(4, 0, 0)
				            then [Data e Hora]
				            else null,
				        type nullable datetime
				    ),
				
				    // 5B. Data e Hora Ajustada — registros entre 00:00 e 03:59 recebem +1 dia
				    // Replica exatamente a coluna calculada DAX original "Data e Hora Ajustada"
				    #"DataHora Ajustada" = Table.AddColumn(
				        #"DataHora Filtro Mínimo",
				        "Data e Hora Ajustada",
				        each
				            let
				                hora = Time.From([Data e Hora])
				            in
				                if hora >= #time(0, 0, 0) and hora < #time(4, 0, 0)
				                then DateTime.From(Date.AddDays(Date.From([Data e Hora]), 1))
				                     + Duration.From(hora)
				                else [Data e Hora],
				        type datetime
				    ),
				
				    // 6. Agrupamento — equivalente ao ALLEXCEPT(DINVPB_ABATE, DATA, NROEMPRESA, Turno)
				    // _HoraMax usa "Data e Hora Ajustada" — igual ao DAX original
				    // _HoraMin usa "_DataHoraParaMin" — somente horas >= 04:00
				    #"Tabela Agrupada" = Table.Group(
				        #"DataHora Ajustada",
				        {"DATA", "NROEMPRESA", "Turno"},
				        {
				            {"_HoraMax",
				                each List.Max([Data e Hora Ajustada]),
				                type nullable datetime},
				            {"_HoraMin",
				                each List.Min([_DataHoraParaMin]),
				                type nullable datetime},
				            {"_Contar Linhas",
				                each Table.RowCount(_),
				                type number}
				        }
				    ),
				
				    // 7. Merge do agrupamento de volta na tabela fato principal
				    #"Mesclado Com Agrupamento" = Table.NestedJoin(
				        #"DataHora Ajustada",
