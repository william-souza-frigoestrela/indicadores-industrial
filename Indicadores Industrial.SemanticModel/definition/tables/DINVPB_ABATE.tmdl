	column _NOVACLASSIFRED = ```
			
			SWITCH( 
			    TRUE(),
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] = "G.", "GRAXARIA",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] = "O.", "CONSERVA",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] = "E.C.", "EMB.COZIDO",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] = "TF", "TRAT.FRIO",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] = "GRAXARIA", "GRAXARIA",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] = "CONSERVA", "CONSERVA",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE] <> BLANK(),"NORMAL",
			    DINVPB_ABATE[DESCRREDCLASSIFABATE])
			```
		lineageTag: 14c15c74-1552-4b9f-ac1c-d2b03f81b474
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Pk = DINVPB_ABATE[NROEMPRESA]&DINVPB_ABATE[NROPEDIDO]
		lineageTag: 6521ed68-1a67-44e2-a98f-6e091548c196
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data e Hora Ajustada' = ```
			
			VAR DataHora = DINVPB_ABATE[Data e Hora]
			VAR Hora = DataHora - TRUNC ( DataHora )
			RETURN
			IF (
			    Hora >= TIME ( 0, 0, 0 )
			        && Hora < TIME ( 4, 0, 0 ),
			     DataHora  + 1,
			     DataHora 
			)
			
			
			
			```
		dataType: dateTime
		formatString: General Date
