	column _DK = DINVPB_ENTRADABANHA[NROPROGPRODUCAO]&DINVPB_ENTRADABANHA[LOTE]&DINVPB_ENTRADABANHA[NROEMPRESA]
		lineageTag: d344bb67-867d-489d-b6fe-5f62b10005fa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _Entrada =
			
			var week = WEEKDAY(DINVPB_ENTRADABANHA[DATAENT],1)
			RETURN
			IF(week = 7, DINVPB_ENTRADABANHA[DATAENT] & " 02:50:00", DINVPB_ENTRADABANHA[DATAENT] & " 05:00:00")
		dataType: dateTime
		formatString: General Date
		lineageTag: dcabcf91-5ab8-4af6-a7fd-f06eee226bbc
		summarizeBy: none

		variation Variation
			isDefault
			relationship: f748d80f-08be-46b9-ad02-a2dad80a5431
			defaultHierarchy: LocalDateTable_d5e39d46-f440-4244-886e-04eb6384871b.'Hierarquia de datas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column _Saída =
			
			var week = WEEKDAY(DINVPB_ENTRADABANHA[DATAENT],1)
			RETURN
			IF(week = 7, DINVPB_ENTRADABANHA[DATAENT] & " 12:00:00", DINVPB_ENTRADABANHA[DATAENT] & " 15:30:00")
		dataType: dateTime
		formatString: General Date
		lineageTag: dcac3a88-70fe-4b02-982e-d77448b8ae2d
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 503f04c4-34cb-4622-823a-d8c442bcabd5
			defaultHierarchy: LocalDateTable_3c257bbf-6703-4fa8-870c-e21981d691bf.'Hierarquia de datas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column _Turno = IF(DINVPB_ENTRADABANHA[DATAHORA] >= DINVPB_ENTRADABANHA[_Entrada] && DINVPB_ENTRADABANHA[DATAHORA] <= DINVPB_ENTRADABANHA[_Saída], "Diurno", "Noturno")
		lineageTag: 4edc598e-e49f-467b-a2f2-68093b70f6d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _Weekday = WEEKDAY(DINVPB_ENTRADABANHA[DATAENT],1)
		formatString: 0
		lineageTag: 27241ab1-2f75-402b-bd6a-78b10a963374
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _DataHoraMax = ```
			CALCULATE(
			    MAX(DINVPB_ENTRADABANHA[DATAHORA]), 
			    ALLEXCEPT(DINVPB_ENTRADABANHA, DINVPB_ENTRADABANHA[DTARENDIMENTO], DINVPB_ENTRADABANHA[NROEMPRESA], DINVPB_ENTRADABANHA[_Turno]))
			```
		formatString: General Date
		lineageTag: 93687081-9fcd-4dcb-ae3d-135e6d8338ab
		summarizeBy: none

		variation Variation
			isDefault
			relationship: e4f6ceae-40b1-4fb8-a988-daec4a22b966
			defaultHierarchy: LocalDateTable_90d03484-596d-4a2f-a0b2-fad5cb8732e1.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column _DataHoraMin =
			CALCULATE(
			    MIN(DINVPB_ENTRADABANHA[DATAHORA]),
			    ALLEXCEPT(DINVPB_ENTRADABANHA, DINVPB_ENTRADABANHA[DTARENDIMENTO], DINVPB_ENTRADABANHA[NROEMPRESA], DINVPB_ENTRADABANHA[_Turno]))
		formatString: General Date
		lineageTag: 0d2e3961-9a58-478b-85eb-fefbb64d56af
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 30d66d88-bfd4-4353-a98f-0d7551496708
			defaultHierarchy: LocalDateTable_cd0f39b5-c75c-48fb-a45a-9c2f23f62c03.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

