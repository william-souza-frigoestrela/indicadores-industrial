	partition 'Indicadores Abate' = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Indicador", STRING,
				    "Un", STRING, 
				    "Ordem", INTEGER,
				    {
				        {"Cabeças Abatidas","Qtde", 0},
				        {"Produtividade Abate Kg/Hh","Kg/Hhr", 1},
				        {"Produtividade Abate Cbç/Hh","Cbç/Hhr", 2},
				        {"Velocidade Abate Cbç/H","Cbç/Hhr", 3},
				        {"% Eficiência Abate","%", 4},
				        {"% Rendimento Vivo","%", 5},
				        {"% Habilitado ME - CHN/UE","%", 6},
				        {"% Habilitado ME - LG/LE","%", 7},
				        {"% Absenteísmo Abate","%", 8},
				        {"% Quebra Frio / Asperção","%",9},
				        {"% Desvio DIF","%",10}
				    
				    }
				)
				
				```

	annotation PBI_Id = fce916d00a1245bc92b779c89a05fb0e

