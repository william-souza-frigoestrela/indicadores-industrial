	column '_Verifica Dia' =
			
			VAR ABATE = CALCULATE(
			    MAX(FPBI_RESUMOABATE[DATA]),
			    FILTER(
			        FPBI_RESUMOABATE,
			        FPBI_RESUMOABATE[DATA] = FPBI_PONTODIARIO[DATA]))
			VAR DESOSSA = CALCULATE(
			    MAX(DINVPB_ENTRADADESOSSA[DTARENDIMENTO]),
			    FILTER(
			        DINVPB_ENTRADADESOSSA,
			        DINVPB_ENTRADADESOSSA[DTARENDIMENTO] = FPBI_PONTODIARIO[DATA]))
			VAR MIUDOS = CALCULATE(
			    MAX(FPBI_RESUMOABATE[DATA]),
			    FILTER(
			        FPBI_RESUMOABATE,
			        FPBI_RESUMOABATE[DATA] = FPBI_PONTODIARIO[DATA]))
			VAR INDUS = CALCULATE(
			    MAX(DINVPB_PRODUCAOINDUS[_Data]),
			    FILTER(
			        DINVPB_PRODUCAOINDUS,
			        DINVPB_PRODUCAOINDUS[_Data] = FPBI_PONTODIARIO[DATA]))
			RETURN
			IF(
			SWITCH(
			    TRUE(),
			    FPBI_PONTODIARIO[SETOR] IN {"CURRAL","POCILGA", "NATURA AREA QUENTE", "NATURA ÁREA QUENTE","NATURA AREA QUENTE","IN NATURA AREA QUENTE","TRIPARIA","BUCHARIA","ABATE","GRAXARIA"}, FPBI_PONTODIARIO[DATA] = ABATE,
			    FPBI_PONTODIARIO[SETOR] IN {"BUCHARIA", "MIUDOS", "BUCHARIA SUJA","BUCHARIA LIMPA", "BUCHARIA - LIMPA", "BUCHARIA - SUJA"}, FPBI_PONTODIARIO[DATA] = MIUDOS,
			    FPBI_PONTODIARIO[SETOR] IN {"DESOSSA", "CAIXARIA", "CORTE", "DESOSSA DIURNO", "DESOSSA NOTURNO", "CAIXARIA DIURNO", "CAIXARIA NOTURNO","DESOSSA DIURNA", "DESOSSA NOTURNA", "CAIXARIA DIURNA", "CAIXARIA NOTURNA"}, FPBI_PONTODIARIO[DATA] = DESOSSA,
			    FPBI_PONTODIARIO[DEPARTAMENTO] IN {"INDUSTRIA INDUSTRIALIZADOS","INDUSTRIA EMBUTIDOS","INDUSTRIA EMBUTIDO"}, FPBI_PONTODIARIO[DATA] = INDUS) = TRUE(), 1, 0)
		formatString: 0
		lineageTag: 827c6137-caaf-4a52-ada3-f089eac38c82
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '_Ocorrencia Novo' = ```
			SWITCH(
			    TRUE(), FPBI_PONTODIARIO[OCORRENCIA] in {"Falta", "Falta Simples","Suspensão" },"Falta/Suspensao", 
			            FPBI_PONTODIARIO[OCORRENCIA] in {"-","Compensado BH", "Folga"}, "Normal", 
			        FPBI_PONTODIARIO[OCORRENCIA])
			```
		lineageTag: 3fc21446-8b0f-4623-9dd2-c82b12da1350
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_Turno v2' =
			
			SWITCH(
			    TRUE(),
			    FPBI_PONTODIARIO[_Turno] = "1° TURNO", "DIURNO",
			    FPBI_PONTODIARIO[_Turno] = "2° TURNO", "NOTURNO",
			    FPBI_PONTODIARIO[_Turno] = "3° TURNO", "NOTURNO")
		lineageTag: d0272631-56f4-4160-8581-3793eb1a1be0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

