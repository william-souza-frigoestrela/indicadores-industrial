				    #"ESTV_FUNCDIASAFASTADOS Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "ESTV_FUNCDIASAFASTADOS", {"CODFUNCIONARIO"}, {"CODFUNCIONARIO.1"}),
				    #"Linhas Filtradas2" = Table.SelectRows(#"ESTV_FUNCDIASAFASTADOS Expandido", each ([CODFUNCIONARIO.1] = null)),
