				        else if Text.Contains([SECAO], "NOTURNA") then "2° TURNO" 
				        else if Text.Contains([SECAO], "3° TURNO") then "3° TURNO" 
				        else if Text.Contains([SETOR], "NOTURNO") then "2° TURNO" 
				        else if Text.Contains([SETOR], "NOTURNA") then "2° TURNO" 
