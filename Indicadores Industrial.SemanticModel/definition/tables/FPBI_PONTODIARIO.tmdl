				    #"Consultas Mescladas2" = Table.NestedJoin(#"Consultas Mescladas1", {"CODFUNCIONARIO"}, #"AFASTADOS ATUALMENTE", {"CODFUNCIONARIO"}, "ESTV_FUNCDIASAFASTADOS (2)", JoinKind.LeftOuter),
