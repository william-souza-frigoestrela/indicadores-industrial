	partition DEPARADESOSSA-330d9a0b-6897-413f-9a5c-512f03fd74b8 = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source = ```
				let
				    Fonte = PowerPlatform.Dataflows(null),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8" = Workspaces{[workspaceId="d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"]}[Data],
				    #"37d71bd8-02a7-4bae-aa23-9f7b98610d23" = #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"{[dataflowId="37d71bd8-02a7-4bae-aa23-9f7b98610d23"]}[Data],
				
				    // NOVAS FONTES
				    MTZ = #"37d71bd8-02a7-4bae-aa23-9f7b98610d23"{[entity="DINVPB_ENTRADADESOSSA_MTZ", version=""]}[Data],
				    TUP = #"37d71bd8-02a7-4bae-aa23-9f7b98610d23"{[entity="DINVPB_ENTRADADESOSSA_TUP", version=""]}[Data],
				    SLG = #"37d71bd8-02a7-4bae-aa23-9f7b98610d23"{[entity="DINVPB_ENTRADADESOSSA_SLG", version=""]}[Data],
				
				    // COMBINANDO AS TABELAS
				    TabelasUnidas = Table.Combine({MTZ, TUP, SLG}),
				
				    // ADICIONANDO A COLUNA CONDICIONAL
				    #"Coluna Condicional Adicionada" = Table.AddColumn(TabelasUnidas, "_CLASSIF.REND", each 
				        if [TIPOPROGPRODUCAO] = "CONSERVA" then "CONSERVA" 
				        else if [TIPOPROGPRODUCAO] = "TRATAMENTO DE FRIO" then "T.F" 
				        else if Text.Contains([DESCRLOTE], "SALSICHARIA") then "NORMAL" 
				        else if Text.Contains([DESCRLOTE], "CH") then "CHN" 
				        else if Text.Contains([DESCRLOTE], "ANGUS") then "ANGUS" 
				        else "NORMAL"
				    ),
				    #"Coluna Mesclada Inserida" = Table.AddColumn(#"Coluna Condicional Adicionada", "Conc", each Text.Combine({Text.From([NROPROGPRODUCAO], "pt-BR"), [LOTE], Text.From([NROEMPRESA], "pt-BR")}, ""), type text),
				 #"Removidas Duplicatas" = Table.Distinct(#"Coluna Mesclada Inserida", {"Conc"})
				in
				    #"Removidas Duplicatas"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

