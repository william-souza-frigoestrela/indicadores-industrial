		summarizeBy: none
		sourceColumn: NROEMPRESA

		annotation SummarizationSetBy = Automatic

	column _Turno =
			
			var var01 = IF(DEPARADESOSSA[LOTE] = 18 ||DEPARADESOSSA[LOTE] = 20 || DEPARADESOSSA[LOTE] = 21 || DEPARADESOSSA[LOTE] > 30,"Noturno" ,"Diurno")
			RETURN
			IF(DEPARADESOSSA[DESCRFAMILIA] = "CUPIM", BLANK(), IF(DEPARADESOSSA[NROEMPRESA] <> 2, "Diurno",var01))
			
			//Se mudar essa formula, trocar em ENTRADADESOSSA / PRODUÇÃO DESOSSA / DEPARADESOSSA
		lineageTag: 6d2bd1d9-efb3-4423-bfba-27b1be3c91d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _DK = DEPARADESOSSA[NROPROGPRODUCAO]&DEPARADESOSSA[LOTE]&DEPARADESOSSA[NROEMPRESA]
		lineageTag: dcd09209-755a-4ba8-9dc6-aa144bc74cec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_Contar Linhas' = ```
			CALCULATE(
			    COUNTROWS(DINVPB_ENTRADADESOSSA), 
			    ALLEXCEPT(DINVPB_ENTRADADESOSSA, DINVPB_ENTRADADESOSSA[DTARENDIMENTO], DINVPB_ENTRADADESOSSA[NROEMPRESA], DINVPB_ENTRADADESOSSA[_Turno]))
			```
		formatString: 0
		lineageTag: 4f9f94b7-9897-4d99-a687-85298e4e4113
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '_Contar Data' = DEPARADESOSSA[DTARENDIMENTO]&DEPARADESOSSA[NROEMPRESA]
		lineageTag: be747ee7-a2c4-40af-ad06-fe3e826b3134
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _NomeEmpresa = ```
			
			IF( 
			    DEPARADESOSSA[_Turno] = BLANK(), RELATED(DGE_EMPRESAMATRIZ[NOMEFILIAL])
			    ,RELATED(DGE_EMPRESAMATRIZ[NOMEFILIAL])&" - "&DEPARADESOSSA[_Turno])
			```
		lineageTag: 48564014-ea0d-4fca-b395-501f6d34dc3f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _LoteChinaPCP = ```
			
			SWITCH(
			    TRUE(),
			    DEPARADESOSSA[LOTE] in {2,13,23,46,53,66} && DEPARADESOSSA[NROEMPRESA] IN {2,104} , "CHN", "OUTROS") 
			```
