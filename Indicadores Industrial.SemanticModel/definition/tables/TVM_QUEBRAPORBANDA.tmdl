	partition TVM_QUEBRAPORBANDA = m
		mode: import
		source = ```
				let
				    Fonte = Oracle.Database("datavale", [HierarchicalNavigation=true, Query="select t.*, '4' as nroempresa from TVM_QUEBRAPORBANDA2@DTVIND04 t#(lf)#(lf)union all#(lf)#(lf)select r.*, '12' as nroempresa from TVM_QUEBRAPORBANDA2@DTVIND12 r#(lf)#(lf)union all #(lf)#(lf)select s.*, '104' as nroempresa from TVM_QUEBRAPORBANDA2@DTVIND104 s#(lf)#(lf)union all #(lf)#(lf)select e.*, '2' as nroempresa from TVM_QUEBRAPORBANDA2@DTVIND02 e"]),
				    Personalizar1 = Table.SelectRows(Fonte, each [CODIGO] <> 1015 and [CODIGO] <> 1012),
				    #"Personalização Adicionada" = Table.AddColumn(Personalizar1, "Personalizar", each if Date.DayOfWeek([DATA_ABATE], Day.Monday) = 4 
				    then Date.AddDays([DATA_ABATE], 3)
				    else Date.AddDays([DATA_ABATE], 2)),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Personalização Adicionada",{{"Personalizar", type date}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo Alterado",{{"Personalizar", "DataReferencia"}}),
				    #"Columns removed by Measure Killer"= Table.SelectColumns(#"Colunas Renomeadas",{"DATA_ABATE","NROEMPRESA","PESO_QUEBRA","PESO_ABATE"})
				in
				    #"Columns removed by Measure Killer"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

