table TVM_QUEBRAPORBANDA
	lineageTag: f50f5262-24c0-4843-b0ab-e64c539fad6b

	measure PesoQuebra = ```
			
			
			var calc = CALCULATE(sum(TVM_QUEBRAPORBANDA[PESO_QUEBRA])) 
			RETURN 
			
			IF(SELECTEDVALUE(TVM_QUEBRAPORBANDA[NROEMPRESA]) in ({2}),calc *  (1 + (3 / 100)),
			                                                      calc 
			
			)
			```
		lineageTag: a2dd9d55-6c7e-42b4-aa2b-664f63753810

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PesoAbate = ```
			
			
			VAR Empresa = SELECTEDVALUE( TVM_QUEBRAPORBANDA[NROEMPRESA] )
			VAR CalcGeral =
			    CALCULATE( SUM( TVM_QUEBRAPORBANDA[PESO_ABATE] ) )
			VAR CalcEmpresa2_ExcluiQuebraPositiva =
			    CALCULATE(
			        SUM( TVM_QUEBRAPORBANDA[PESO_ABATE] ),
			        KEEPFILTERS( TVM_QUEBRAPORBANDA[PESO_QUEBRA] > 0 )
			    )
			RETURN
			IF(
			    Empresa = 2,
			    CalcEmpresa2_ExcluiQuebraPositiva,   -- para empresa 2, ignora linhas com PESO_QUEBRA > 0
			    CalcGeral                            -- demais empresas, cálculo normal
			)
			
			
			//var calc = CALCULATE(sum(TVM_QUEBRAPORBANDA[PESO_ABATE]))
			//var Empresa = SELECTEDVALUE(TVM_QUEBRAPORBANDA[NROEMPRESA])
			//var PesoQuebraAtual = CALCULATE(SUM(TVM_QUEBRAPORBANDA[PESO_QUEBRA]))
			
			//RETURN 
			//IF(Empresa = 2 && PesoQuebraAtual <> 0 , calc)
			
			
			//IF(SELECTEDVALUE(TVM_QUEBRAPORBANDA[NROEMPRESA]) in ({12}),calc *  (1 + (2 / 100)),
			//                                                      calc  ))))
			```
		lineageTag: c535065c-f18a-452a-9d03-f89cef0d0c5b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

