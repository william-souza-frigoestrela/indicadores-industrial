	column _Turno =
			
			var var01 = IF(HOUR(DINVPB_PAUSATOTAL[DTAHORAINICIAL]) >= 16 && DINVPB_PAUSATOTAL[NROEMPRESA] = 2, "Noturno", "Diurno")
			RETURN
			 var01
