		annotation SummarizationSetBy = Automatic

	partition DINVPB_ENTRADADESOSSA-653429b3-82b3-497b-a24d-d38dbee40bab = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source = ```
				let
				    // 1. Conexão SQL nativa adicionando a coluna NROEMPRESA fixa para cada filial no banco
				    Fonte = Oracle.Database("datavale", [HierarchicalNavigation=true, Query="#(lf)            SELECT #(lf)                2 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_ENTRADADESOSSA@dtvind02 e #(lf)            --WHERE DTARENDIMENTO >= TRUNC(SYSDATE)-60#(lf)WHERE DTARENDIMENTO >= '01-jan-2026'#(lf)            #(lf)            UNION ALL#(lf)            #(lf)            SELECT #(lf)                4 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_ENTRADADESOSSA@dtvind04 e #(lf)            --WHERE DTARENDIMENTO >= TRUNC(SYSDATE)-60#(lf)WHERE DTARENDIMENTO >= '01-jan-2026'#(lf)            #(lf)            UNION ALL#(lf)            #(lf)            SELECT #(lf)                104 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_ENTRADADESOSSA@dtvind104 e #(lf)            --WHERE DTARENDIMENTO >= TRUNC(SYSDATE)-60#(lf)WHERE DTARENDIMENTO >= '01-jan-2026'#(lf)        "]),
				
				    // 2. Coluna condicional _Sexo
				    #"Coluna Condicional Adicionada" = Table.AddColumn(Fonte, "_Sexo", each 
				        if Text.Contains([DESCRICAO], "BOI") then "MACHO" 
				        else if Text.Contains([DESCRICAO], "VACA") then "FEMEA" 
				        else null,
				        type text
				    ),
				
				    // 3. Garantia de tipagem dos dados
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Coluna Condicional Adicionada", {
				        {"NROPROGPRODUCAO", Int64.Type}, 
				        {"DESCRFORMAPRODUCAO", type text}, 
				        {"OBSERVACAO", type text}, 
				        {"TIPOPROGPRODUCAO", type text}, 
				        {"TIPOPRODUTO", type text}, 
				        {"STATUSPROGPRODUCAO", Int64.Type}, 
				        {"LOTE", Int64.Type}, 
				        {"DESCRLOTE", type text}, 
				        {"DATAHORA", type datetime}, 
				        {"DTARENDIMENTO", type datetime}, 
				        {"DTAPRODUCAO", type datetime}, 
				        {"DATAENT", type datetime}, 
				        {"SEQPRODUTO", Int64.Type}, 
				        {"DESCRICAO", type text}, 
				        {"SUBGRUPO", type text}, 
				        {"GRUPO", type text}, 
				        {"FAMILIAPROD", Int64.Type}, 
				        {"DESCRFAMILIA", type text}, 
				        {"CONSERVACAO", type text}, 
				        {"CODBARRAINTERNO", Int64.Type}, 
				        {"QUANTIDADE", Int64.Type}, 
				        {"QTDEMBALAGEM", Int64.Type}, 
				        {"PESOLIQUIDO", type number}, 
				        {"TARA", Int64.Type}, 
				        {"PESOBRUTO", type number}, 
				        {"UNIDADE", type text}, 
				        {"USUARIO", type text}, 
				        {"NROEMPRESA", Int64.Type}, 
				        {"_Sexo", type text}
				    }),
				
				    // 4. Filtro de lotes
				    #"Linhas Filtradas" = Table.SelectRows(#"Tipo Alterado", each [LOTE] <> 19 and [LOTE] <> 21),
				
				    // 5. Seleção das colunas utilizadas no modelo
				    #"Columns removed by Measure Killer" = Table.SelectColumns(#"Linhas Filtradas", {
				        "DTARENDIMENTO",
				        "_Sexo",
				        "PESOLIQUIDO",
				        "NROEMPRESA",
				        "DATAHORA",
				        "DESCRFAMILIA",
				        "QUANTIDADE",
				        "NROPROGPRODUCAO",
				        "SEQPRODUTO",
				        "LOTE"
				    })
				in
				    #"Columns removed by Measure Killer"
				```

	annotation PBI_ResultType = Exception

