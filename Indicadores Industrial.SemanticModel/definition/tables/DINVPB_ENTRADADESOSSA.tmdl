	column '_Verificação 2' =
			DATEDIFF(DATE(YEAR(DINVPB_ENTRADADESOSSA[DATAHORA]),MONTH(DINVPB_ENTRADADESOSSA[DATAHORA]),day(DINVPB_ENTRADADESOSSA[DATAHORA])),DINVPB_ENTRADADESOSSA[DTARENDIMENTO],DAY)
			//Diferença entre DATAHORAENTRADA x DATARENDIMENTO
		formatString: 0
		lineageTag: 932f163c-83ea-441a-abbc-e8463050bb5f
