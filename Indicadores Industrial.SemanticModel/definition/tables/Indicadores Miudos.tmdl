table 'Indicadores Miudos'
	lineageTag: 578f8bc1-3da8-4089-b536-e588eb27757c

	measure ValorIndicadorLinhasMiudos = ```
			
			VAR ind = SELECTEDVALUE('Indicadores Miudos'[IndicadorMiudos])
			RETURN
			SWITCH(
			    ind,
			    "% Rendimento Miudos Cortes",  [% Rendimento Miudos Cortes],
			    "Produtividade Miudos Kg/Hh",  [Produtividade Miudos Kg/Hh],
			    "Produtividade Miudos Cxs/Hh", [Produtividade Miudos Cxs/Hh],
			    "% Absenteísmo Miudos",        [Absenteísmo Miudos], 
			    "% Absenteísmo SubProdutos",   [Absenteísmo Graxaria],
			    "% Rendimento Subpodutos",     [% Rendimento Graxaria],
			    "SupProdutos Kgs/Cbç",         [Kg Subproduto/Cabeça],
			    BLANK()
			)
			```
		lineageTag: 353c63bc-5509-4c33-9848-406bc67940ed

		formatStringDefinition =
				
				VAR _un = SELECTEDVALUE('Indicadores Miudos'[Un])
				
				RETURN
				LOOKUPVALUE(UnidadeInidicadores[Formato], UnidadeInidicadores[Unidade], _un, "#,##0.00" --Fornato padrão caso não encontre
				)

	measure ValorIndicadorMiudios = ```
			
			VAR tipo = SELECTEDVALUE(TipoValor[Tipo])
			RETURN
			IF( tipo = "Meta", [Meta Indicador], [ValorIndicadorLinhasMiudos] )
			
			```
		lineageTag: dad6a7da-f174-402b-8b2e-a56202732b56

		annotation PBI_FormatHint = {"isGeneralNumber":true}

