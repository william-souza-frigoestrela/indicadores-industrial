	partition 'Indicadores Miudos' = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "IndicadorMiudos", STRING,
				    "Un", STRING,
				    "Ordem", INTEGER,
				    {
				        {"% Rendimento Miudos Cortes","%", 0},
				        {"Produtividade Miudos Kg/Hh","Kg/Hhr", 1},
				        {"Produtividade Miudos Cxs/Hh","Cxs/Hhr", 2},
				        {"% Absenteísmo Miudos","%", 3},
				        {"% Rendimento Subpodutos","%",4},
