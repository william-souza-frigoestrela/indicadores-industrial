	partition DINVPB_PESOVIVO = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source =
				let
				    Fonte = PowerPlatform.Dataflows(null),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8" = Workspaces{[workspaceId="d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"]}[Data],
				    #"35024cdc-6a08-4e80-8a93-36e024176d14" = #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"{[dataflowId="35024cdc-6a08-4e80-8a93-36e024176d14"]}[Data],
				
				    // Carregando as duas entidades desejadas
				    DINVPB_PESOVIVO_SLG = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_PESOVIVO_SLG", version=""]}[Data],
				    DINVPB_PESOVIVO_TUP = #"35024cdc-6a08-4e80-8a93-36e024176d14"{[entity="DINVPB_PESOVIVO_TUP", version=""]}[Data],
				
				    // Combinando os dados das duas entidades
				    DadosCombinados = Table.Combine({DINVPB_PESOVIVO_SLG, DINVPB_PESOVIVO_TUP})
				in
				    DadosCombinados

