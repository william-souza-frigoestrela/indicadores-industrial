		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Expedição Ativos' = ```
			
			VAR SETOR = {"EXPEDICAO","PALETIZACAO", "ARMAZENAGEM", "ARMAZENAGEM INDIRETA","EXPEDICAO NOTURNO", "EXPEDICAO DIURNA", "PALETIZAÇÃO DIURNO", "PALETIZAÇÃO", "EXPEDIÇÃO"}
			VAR DATAVALE = 
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(FPBI_PONTODIARIO), 
			        FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR,
			        FPBI_PONTODIARIO[_Verifica Dia] = 1))
			VAR TOTVS =
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(Ponto), 
			    'Base Funcionários'[SETOR] IN SETOR , 
			    Ponto[_QtdFunc] = 1))
			VAR DIAREMPRES = [Func Indus Diarista]+[Func Indus Emprestimo]
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)+DIAREMPRES
			```
		displayFolder: 07. Expedição
		lineageTag: 0e06d021-5055-452f-a539-20ca4af7c8a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Expedição Faltas' =
			
			VAR SETOR = {"EXPEDICAO","PALETIZACAO", "ARMAZENAGEM", "ARMAZENAGEM INDIRETA","EXPEDICAO NOTURNO", "EXPEDICAO DIURNA", "PALETIZAÇÃO DIURNO", "PALETIZAÇÃO", "EXPEDIÇÃO"}
			VAR DATAVALE = AVERAGEX(VALUES('Calendário'[Data]), CALCULATE(SUM (FPBI_ABSENTEISMO[QTDABSTENCIA]),FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR, FPBI_ABSENTEISMO[_Verifica Dia] = 1))
			VAR TOTVS = AVERAGEX(VALUES('Calendário'[Data]),CALCULATE(COUNTROWS(Ponto), Ponto[_ABSENTEISMO] = "S", 'Base Funcionários'[SETOR] IN SETOR))
			RETURN
			IF([Peso Industrializados] = BLANK(), BLANK(), IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS))
		displayFolder: 07. Expedição
		lineageTag: e34bb6a3-9f28-4927-b688-31bee7ba57f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Expedição Férias' =
			
			VAR DATAVALE = CALCULATE(AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Expedição Ativos],FPBI_PONTODIARIO[_Ocorrencia Novo] = "Férias", FPBI_PONTODIARIO[_Verifica Dia] = 1)))
			VAR TOTVS = AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Expedição Ativos], Ponto[FERIAS] = "SIM"))
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0, DATAVALE, TOTVS)
		displayFolder: 07. Expedição
		lineageTag: 2b16881b-f845-42d9-9d21-ed46cacbe738

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Expedição Real' = [Func Expedição Ativos] - [Func Expedição Férias] - [Func Expedição Faltas]
		displayFolder: 07. Expedição
		lineageTag: b74ff4eb-a76e-4e37-8a55-8e05a9b1576c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hora Abate Trabalhadas Ponto' =
			
			var horaponto = CALCULATE(SUM(Ponto[_Horas Trabalhadas]), 'Base Funcionários'[SETOR] IN {"CURRAL","POCILGA", "IN NATURA AREA QUENTE"})
			return
			IF([Qtde_Dias Abate]<>0,DIVIDE(horaponto,[Func Abate Real]),BLANK())
		displayFolder: 01. Abate
		lineageTag: 718785c6-0cce-4eb4-889d-5ec8def35de3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hora Abate Trabalhada Ponto H:H' =
			
			VAR HORADECIMAL = [Hora Abate Trabalhadas Ponto]
			VAR HORA = IF(ISBLANK(INT(HORADECIMAL)), "00", IF(INT(HORADECIMAL) < 10, "0"&INT(HORADECIMAL) , INT(HORADECIMAL)))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) = 0, INT(DIF * 60)& "0", INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Abate Trabalhadas Ponto]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 01. Abate
		lineageTag: 60d6e973-529c-486f-9df6-a54c925f69ca

