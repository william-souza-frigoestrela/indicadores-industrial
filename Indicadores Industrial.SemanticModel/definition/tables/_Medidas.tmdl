	measure 'Hora Desossa Pausas' = ```
			
			CALCULATE(
			    SUMX(
			    DINVPB_PAUSATOTAL, 
			    DATEDIFF(DINVPB_PAUSATOTAL[DTAHORAINICIAL],DINVPB_PAUSATOTAL[DTAHORAFINAL], MINUTE) / 60), 
			        DINVPB_PAUSATOTAL[TIPO] = "DESOSSA",
			            DINVPB_PAUSATOTAL[_Verificação] = "Considerar",
			            DINVPB_PAUSATOTAL[TIPOPAUSA] = "ERGONOMICA")
			```
		displayFolder: 06. Desossa e Caixaria
		lineageTag: b8da56bb-1801-4783-b5cb-dc59dbfd8873

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hora Desossa Almoço' = ```
			CALCULATE(
			    SUMX(
			    DINVPB_PAUSATOTAL, 
			    DATEDIFF(DINVPB_PAUSATOTAL[DTAHORAINICIAL],DINVPB_PAUSATOTAL[DTAHORAFINAL], MINUTE) / 60), 
			        DINVPB_PAUSATOTAL[TIPO] = "DESOSSA",
			            DINVPB_PAUSATOTAL[_Verificação] = "Considerar",
			            DINVPB_PAUSATOTAL[TIPOPAUSA] = "ALMOÇO")
			```
		displayFolder: 06. Desossa e Caixaria
		lineageTag: edc895f9-8416-4138-9aa8-a3493b822788

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hora Desossa Total' =
			
			sumx(DINVPB_ENTRADADESOSSA,
			    DATEDIFF(DINVPB_ENTRADADESOSSA[_DataHoraMin],DINVPB_ENTRADADESOSSA[_DataHoraMax], MINUTE) / 60 / DINVPB_ENTRADADESOSSA[_Contar Linhas])
		displayFolder: 06. Desossa e Caixaria
