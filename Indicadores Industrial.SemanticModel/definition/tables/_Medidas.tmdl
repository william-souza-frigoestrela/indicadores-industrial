			VAR MediaPonderada =
			    DIVIDE(
			        SUMX(
			            VALUES(_Turno[Turno]),
			            [Horas Trabalhadas Desossa]  * [Func Desossa Real]
			        ),
			        CALCULATE(
			            [Func Desossa Real],
