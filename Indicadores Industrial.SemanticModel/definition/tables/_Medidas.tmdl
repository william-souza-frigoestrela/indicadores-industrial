	measure 'Peso Graxaria' =
			
			VAR PesoOutrosItens =
			    CALCULATE (
			        SUM ( DINVPB_PRODUCAOMIUDOS[PESOLIQUIDO] ),
			        DINVPB_PRODUCAOMIUDOS[DESCRFAMILIA] IN {
			            "SUBPRODUTOS GRAXARIA", "SUBPRODUTOS MIUDOS", "COURO VERDE",
			            "SANGUE", "SANGUE FETAL", "CASCOS E CHIFRES",
			            "GRAXARIA MIUDOS", "SUB-PRODUTOS","SUBPRODUTOS TRIPARIA"
			        },
			        DINVPB_PRODUCAOMIUDOS[SEQPRODUTO] <> 14008
			    )
			
			VAR PesoItem14008 =
			    SUMX (
			        VALUES ( DINVPB_PRODUCAOMIUDOS[NROPROGPRODUCAO] ),
			        CALCULATE (
			            SUM ( DINVPB_PRODUCAOMIUDOS[PESOLIQUIDO] ),
			            REMOVEFILTERS ( 'Calendário' ),
			            DINVPB_PRODUCAOMIUDOS[SEQPRODUTO] = 14008,
			            DINVPB_PRODUCAOMIUDOS[DESCRFAMILIA] IN {
			                "SUBPRODUTOS GRAXARIA", "SUBPRODUTOS MIUDOS", "COURO VERDE",
			                "SANGUE", "SANGUE FETAL", "CASCOS E CHIFRES",
			                "GRAXARIA MIUDOS", "SUB-PRODUTOS"
			            }
			        )
			    )
			
			RETURN
			    PesoOutrosItens + PesoItem14008
		displayFolder: 04. SubProduto
		lineageTag: 71611138-9f96-43f4-87b4-c914257ded0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Produtividade Graxaria Kg/HH' =
			//DIVIDE(DIVIDE([Peso Graxaria], [Func Graxaria Real]), [Hora Abate])
			
			DIVIDE(
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        DIVIDE([Peso Graxaria], [Func Graxaria Real])
			    ),
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        [Hora Abate]
			    )
			)
		displayFolder: 04. SubProduto
		lineageTag: f361463c-76f5-43c0-b6e9-1454d70578b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Formatar Kg/HH Graxaria' =
