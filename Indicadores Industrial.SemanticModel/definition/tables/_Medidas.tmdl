	measure 'Hora Final Caixaria' = MAX(DINVPB_PRODUCAODESOSSA[DATAHORAENT])
		formatString: General Date
		displayFolder: 06. Desossa e Caixaria
		lineageTag: 6c344baa-2e36-4c52-a3ea-f13b33f9ff88

	measure 'Hora Desossa Pausas H:H' =
			
			VAR HORADECIMAL = [Hora Desossa Pausas]
			VAR HORA = IF(INT(HORADECIMAL) >= 10, INT(HORADECIMAL), "0" & INT(HORADECIMAL))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) <10, "0" & INT(DIF * 60), INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Desossa Pausas]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 06. Desossa e Caixaria
		lineageTag: 619f7714-dc26-4f62-8da8-ee37ab11889e

	measure 'Hora Desossa Almoço H:H' =
			
			VAR HORADECIMAL = [Hora Desossa Almoço]
			VAR HORA = IF(INT(HORADECIMAL) >= 10, INT(HORADECIMAL), "0"&INT(HORADECIMAL))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) <10, "0"&INT(DIF * 60), INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Desossa Almoço]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 06. Desossa e Caixaria
		lineageTag: cac88111-2bc6-43c0-8073-40d3e8a941b9

	measure 'Hora Desossa Total H:H' =
			
			VAR HORADECIMAL = [Hora Desossa Total]
			VAR HORA = IF(INT(HORADECIMAL) >= 10, INT(HORADECIMAL), "0"&INT(HORADECIMAL))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) <10, "0"&INT(DIF * 60), INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			IF(SUM(DEPARADESOSSA[_Contar Linhas])=0,BLANK(),FORMATOTEXTO)
		displayFolder: 06. Desossa e Caixaria
		lineageTag: 22ed2df2-a337-4c88-a9fb-be69c4994302

