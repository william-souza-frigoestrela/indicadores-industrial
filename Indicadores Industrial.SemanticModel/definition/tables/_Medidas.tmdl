	measure 'Func Graxaria Férias' = ```
			
			var vr1 = CALCULATETABLE(VALUES(Ponto[DATA]),Ponto[Horas Trabalhadas Total Setor] > 0 )
			
			 VAR DATAVALE = CALCULATE( AVERAGEX( VALUES('Calendário'[Data]), CALCULATE( [Func Graxaria Ativos] - [Func Graxaria Diarista] - [Func Graxaria Emprestimo], FPBI_PONTODIARIO[_Ocorrencia Novo] = "Férias", FPBI_PONTODIARIO[_Verifica Dia] = 1 ) ) ) 
			
			 VAR TOTVS = AVERAGEX( vr1, CALCULATE( [Func Graxaria Ativos], Ponto[FERIAS] = "SIM" )) - ([Func Graxaria Diarista] + [Func Graxaria Emprestimo])
			
			RETURN IF( SUMX('Calendário', 'Calendário'[_Filtro RH]) > 0,
			 IF([Qtde_Dias Abate] <> 0, DATAVALE, BLANK()), TOTVS )
