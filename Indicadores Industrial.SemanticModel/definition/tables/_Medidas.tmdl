	measure 'Indicador Compra.' =
			
			VAR Cbc = [Compra2 Cabeças Abatidas]
			VAR PesoArroba = [Compra2 Peso Médio @]
			VAR VlrArroba = [Valor @ Colocado]
			VAR VlrCbc = [Compra2 Vlr Cabeça]
			VAR VlrCompra = [Compra2 Valor Total]
			RETURN
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(_FiltroCompra[Indicador Compra]) = "Valor Total", IF(VlrCompra = BLANK(), BLANK(), FORMAT(VlrCompra,"R$ ###,###.00")),
			    SELECTEDVALUE(_FiltroCompra[Indicador Compra]) = "Valor Arroba @", IF(VlrArroba = BLANK(), BLANK(), FORMAT(VlrArroba,"R$ ###,###.00")),
			    SELECTEDVALUE(_FiltroCompra[Indicador Compra]) = "Peso Arroba @", PesoArroba,
			    SELECTEDVALUE(_FiltroCompra[Indicador Compra]) = "Quantidade Cabeças", Cbc,
			    SELECTEDVALUE(_FiltroCompra[Indicador Compra]) = "Valor por Cabeça", IF(VlrCbc = BLANK(), BLANK(),FORMAT(VlrCbc,"R$ ###,###.00")))
