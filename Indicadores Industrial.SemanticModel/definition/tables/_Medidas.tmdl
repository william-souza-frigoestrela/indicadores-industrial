	measure 'Hora Abate Trabalhadas' = ```
			
			/*SUMX(
			    DINVPB_ABATE, 
			    DATEDIFF(DINVPB_ABATE[_HoraMin], DINVPB_ABATE[_HoraMax], MINUTE) / DINVPB_ABATE[_Contar Linhas] / 60)
			*/
			DIVIDE(SUM(DINVPB_ABATE[_MinutosTrabalhados]), 60)
			```
