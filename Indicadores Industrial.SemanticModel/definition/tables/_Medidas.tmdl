	measure 'Peso Industrializados' =
			
			CALCULATE(
			    SUM(DINVPB_PRODUCAOINDUS[PESOLIQUIDO]),
			    DINVPB_PRODUCAOINDUS[_TIPO] = "PRODUÇÃO NORMAL"
			)
		displayFolder: 08. Industrializados
		lineageTag: 74f043f8-57ab-4479-9c35-37e0d0ea04a0

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Indus Ativos' = ```
			
			VAR DEPARTAMENTO = {"INDUSTRIA INDUSTRIALIZADOS","INDUSTRIA EMBUTIDOS","INDUSTRIA EMBUTIDO"}
			VAR DATAVALE = 
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(FPBI_PONTODIARIO), 
			        FPBI_FUNCIONARIO[DESCRDEPARTAMENTO] IN DEPARTAMENTO,
			        FPBI_PONTODIARIO[_Verifica Dia] = 1))
			VAR TOTVS =
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(Ponto), 
			    'Base Funcionários'[DEPARTAMENTO] IN DEPARTAMENTO , 
			    Ponto[_QtdFunc] = 1))
			VAR DIAREMPRES = [Func Indus Diarista]+[Func Indus Emprestimo]
			RETURN
			IF([Peso Industrializados] = BLANK(), BLANK(), IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)+DIAREMPRES)
			```
		displayFolder: 08. Industrializados
		lineageTag: 6e63ebb7-0d13-4469-a8ae-186df87988a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Indus Faltas' =
			
			VAR DEPARTAMENTO = {"INDUSTRIA INDUSTRIALIZADOS","INDUSTRIA EMBUTIDOS"}
			VAR DATAVALE = AVERAGEX(VALUES('Calendário'[Data]), CALCULATE(SUM (FPBI_ABSENTEISMO[QTDABSTENCIA]),FPBI_FUNCIONARIO[DESCRDEPARTAMENTO] IN DEPARTAMENTO, FPBI_ABSENTEISMO[_Verifica Dia] = 1))
			VAR TOTVS = AVERAGEX(VALUES('Calendário'[Data]),CALCULATE(COUNTROWS(Ponto), Ponto[_ABSENTEISMO] = "S", 'Base Funcionários'[DEPARTAMENTO] IN DEPARTAMENTO))
			RETURN
			IF([Peso Industrializados] = BLANK(), BLANK(), IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS))
		formatString: 0
		displayFolder: 08. Industrializados
		lineageTag: ecb3c4e0-7c53-448a-8fca-d456dc15b095

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Func Indus Férias' =
			
			VAR DATAVALE = CALCULATE(AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Indus Ativos],FPBI_PONTODIARIO[_Ocorrencia Novo] = "Férias", FPBI_PONTODIARIO[_Verifica Dia] = 1)))
			VAR TOTVS = AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Indus Ativos], Ponto[FERIAS] = "SIM"))
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)
		formatString: 0
		displayFolder: 08. Industrializados
		lineageTag: 5ab28c84-ad98-44f3-877d-d706c5ab6fd7

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Absenteísmo Indus' = DIVIDE([Func Indus Faltas],[Func Indus Ativos])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 08. Industrializados
		lineageTag: bf278602-5e21-4c25-84cd-f9f6a0276b5c

	measure 'Horas Indus' = ```
			CALCULATE(
			    SUM(Ponto[_Horas Trabalhadas]), 
			    'Base Funcionários'[DEPARTAMENTO] in {"INDUSTRIA INDUSTRIALIZADOS","INDUSTRIA EMBUTIDOS","INDUSTRIA EMBUTIDO"})
			```
		displayFolder: 08. Industrializados
		lineageTag: 119d8e82-3d02-458c-ba02-fbea7e0c2334

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Indus Real' = [Func Indus Ativos] - [Func Indus Férias] - [Func Indus Faltas]
		formatString: 0
		displayFolder: 08. Industrializados
		lineageTag: 43991541-fb98-45be-b0c6-30e83d60e9ed

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Produtividade Indus Kg/Hh' = ```
			//DIVIDE(DIVIDE([Peso Industrializados],[Func Indus Real]) , [Horas Trabalhadas Indus])
			
			DIVIDE(
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        DIVIDE([Peso Industrializados], [Func Indus Real])
			    ),
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        [Horas Trabalhadas Indus]
			    )
			)
			
			```
		displayFolder: 08. Industrializados
		lineageTag: 506302ec-6cec-443e-991b-a00509e3ef71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Horas Trabalhadas Indus' =
			
			var TOTVS = DIVIDE([Horas Indus] , [Func Indus Real])
			var DATAVALE = [DTV Hora Indus]
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)
		displayFolder: 08. Industrializados
		lineageTag: 6adecfc9-8bb5-4eba-816a-05926e175b07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Retrabalho' = ```
			VAR RETRAB = CALCULATE(SUM(DINVPB_PRODUCAOINDUS[PESOLIQUIDO]),DINVPB_PRODUCAOINDUS[_TIPO]="RETRABALHO")
			             VAR PROD = CALCULATE(SUM(DINVPB_PRODUCAOINDUS[PESOLIQUIDO]), DINVPB_PRODUCAOINDUS[_TIPO] ="PRODUÇÃO NORMAL")
			             RETURN
			            DIVIDE(RETRAB,PROD,0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 08. Industrializados
		lineageTag: 1fb40dda-2069-43e4-ab4d-1bfbc6ea006f

