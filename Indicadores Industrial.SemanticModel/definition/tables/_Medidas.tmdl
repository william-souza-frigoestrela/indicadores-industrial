	measure 'Produtividade Desossa Kg/HHr' = ```
			// AVERAGEX(VALUES('Calendário'[Data]),DIVIDE(DIVIDE([Peso Entrada Desossa], [Func Desossa Total Real]), [Hora Desossa Trab.]))
			
			DIVIDE(
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        DIVIDE([Peso Entrada Desossa], [Func Desossa Total Real])
			    ),
			    SUMX(
