	measure 'Produtividade Desossa Pç/Hh' = ```
			//DIVIDE(DIVIDE([Peças Processadas Desossa], [Func Desossa Total Real]), [Hora Desossa Trab.])
			
			DIVIDE(
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        DIVIDE([Peças Processadas Desossa], [Func Desossa Total Real])
			    ),
			    SUMX(
			        ALLSELECTED(_Turno[Turno]),
			        [Hora Desossa Trab.]
			    )
			)
			
			```
		displayFolder: 06. Desossa e Caixaria
		lineageTag: 17b1b287-4acc-44e1-b4f7-f4c2f0571805

