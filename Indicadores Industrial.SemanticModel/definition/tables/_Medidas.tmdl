	measure '_Ajuste Peso Entrada Desossa Fralda' =
			
			var qtdfralda = CALCULATE([Qtd. Saída Desossa],DINVPB_PRODUCAODESOSSA[DESCRFAMILIA] = "FRALDA")
			var entradafralda = qtdfralda * [Peso Entrada Médio]
			RETURN
			SWITCH(
			    TRUE(),
			    [Peso Saída Desossa] = BLANK(), BLANK(),
			    SELECTEDVALUE(DINVPB_PRODUCAODESOSSA[DESCRFAMILIA]) = "FRALDA", entradafralda,
			    [Peso Entrada Desossa]) // FRALDA RETIRADA DA PA COMPLETA, ENVIADA PARA DESOSSA (AJUSTE PCP)
