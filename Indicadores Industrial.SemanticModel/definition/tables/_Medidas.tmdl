	measure 'Func Miudos Faltas Base' = ```
			
			VAR SETOR = {
			    "BUCHARIA", "MIUDOS", "BUCHARIA SUJA",
			    "BUCHARIA LIMPA", "BUCHARIA - LIMPA", "BUCHARIA - SUJA"
			}
			
			var vr1 = CALCULATETABLE(VALUES(Ponto[DATA]),Ponto[Horas Trabalhadas Total Setor] > 0 )
			 
			
			VAR DATAVALE =
			    AVERAGEX (
			        VALUES ( 'Calendário'[Data] ),
			        CALCULATE (
			            SUM ( FPBI_ABSENTEISMO[QTDABSTENCIA] ),
			            FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR,
			            FPBI_ABSENTEISMO[_Verifica Dia] = 1
			        )
			    )
			VAR TOTVS =
			    AVERAGEX (
			        VR1,
			        CALCULATE (
			           COUNTROWS(Ponto),
			            Ponto[_ABSENTEISMO] = "S",
			            'Base Funcionários'[SETOR] IN SETOR,
			             Ponto[Horas Trabalhadas Total Setor] > 0
			        ) + 0
			   )
			RETURN
			    IF (
			        SUMX ( 'Calendário', 'Calendário'[_Filtro RH] ) > 0,
			        IF ( [Hora Abate Trabalhadas] <> 0, DATAVALE, BLANK () ),
			        IF ( [Hora Abate Trabalhadas] <> 0, TOTVS, BLANK () )
			   )
			
			
			    
			```
