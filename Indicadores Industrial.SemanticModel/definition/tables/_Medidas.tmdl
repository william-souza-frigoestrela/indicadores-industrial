	measure 'Func Ativos' = ```
			
			VAR DATAVALE = 
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(FPBI_PONTODIARIO), 
			        FPBI_PONTODIARIO[_Verifica Dia] = 1))
			VAR TOTVS =
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(Ponto), 
			    Ponto[_QtdFunc] = 1))
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)
			```
		formatString: 0
		lineageTag: 5fbcee8f-904b-4dd1-9415-b576ccf7f25c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Func Férias' =
			
			VAR DATAVALE = CALCULATE(AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Ativos],FPBI_PONTODIARIO[_Ocorrencia Novo] = "Férias", FPBI_PONTODIARIO[_Verifica Dia] = 1)))
			VAR TOTVS = AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Ativos], Ponto[FERIAS] = "SIM"))
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)
		formatString: 0
		lineageTag: f9df18b6-794f-4255-a8ce-fe9a4ca92b5a

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Func Faltas' =
			
			VAR DATAVALE = AVERAGEX(VALUES('Calendário'[Data]), CALCULATE(SUM (FPBI_ABSENTEISMO[QTDABSTENCIA]), FPBI_ABSENTEISMO[_Verifica Dia] = 1))
			VAR TOTVS = AVERAGEX(VALUES('Calendário'[Data]),CALCULATE(COUNTROWS(Ponto), Ponto[_ABSENTEISMO] = "S"))
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,DATAVALE,TOTVS)
		formatString: 0
		lineageTag: ab33cbae-5f46-4ceb-913e-2df474453a40

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Func Real' = ```
			
			AVERAGEX(
			    VALUES('Calendário'[Data]), 
			    [Func Ativos] - [Func Faltas] - [Func Férias])
