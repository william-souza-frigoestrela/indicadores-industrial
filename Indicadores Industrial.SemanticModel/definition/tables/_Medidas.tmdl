	measure 'Func Abate Real' = ```
			
			AVERAGEX(
			    VALUES('Calendário'[Data]), 
			    [Func Abate Ativos] - [Func Abate Faltas Base] - [Func Abate Férias])
			```
		formatString: 0
		displayFolder: 01. Abate
		lineageTag: a0f8095f-f5a5-4d40-863a-87433ac3a5fb

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Func Abate Ativos' = ```
			
			VAR SETOR = {"NATURA AREA QUENTE", "NATURA ÁREA QUENTE","NATURA AREA QUENTE","IN NATURA AREA QUENTE","IN NATURA","ABATE"}
			VAR DATAVALE = 
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(FPBI_PONTODIARIO), 
			        FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR,
			        FPBI_PONTODIARIO[_Verifica Dia] = 1))
			VAR TOTVS =
			AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(Ponto), 
			    'Base Funcionários'[SETOR] IN SETOR ,
			    Ponto[_QtdFunc] = 1))
			VAR DIAREMPRES = [Func Miudos Diarista]+[Func Abate Emprestimo]
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,IF([Hora Abate Trabalhadas] = BLANK(),BLANK(),DATAVALE),IF([Hora Abate Trabalhadas] = BLANK(),BLANK(),TOTVS)) + DIAREMPRES
			```
		displayFolder: 01. Abate
		lineageTag: 2fcf8316-2e15-459f-b5be-c59b741b9226

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Abate Férias' =
			
			var vr1 = CALCULATETABLE(VALUES(Ponto[DATA]),Ponto[Horas Trabalhadas Total Setor] > 0 )
			VAR DATAVALE = CALCULATE(AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Abate Ativos],FPBI_PONTODIARIO[_Ocorrencia Novo] = "Férias", FPBI_PONTODIARIO[_Verifica Dia] = 1)))
			VAR TOTVS = AVERAGEX(vr1, CALCULATE([Func Abate Ativos], Ponto[FERIAS] = "SIM")) - ([Func Abate Diarista]+[Func Abate Emprestimo])
			RETURN IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,IF([Hora Abate Trabalhadas]<>0,DATAVALE,BLANK()),IF([Hora Abate Trabalhadas]<>0,TOTVS,BLANK()))
		displayFolder: 01. Abate
		lineageTag: c7868c16-c7d5-479a-8e89-81c0e518c4f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Func Abate Faltas Base' =
			
			VAR SETOR = {
			     "NATURA AREA QUENTE",
			    "NATURA ÁREA QUENTE","NATURA AREA QUENTE",
			    "IN NATURA AREA QUENTE","IN NATURA","ABATE"
			}
			var vr1 = CALCULATETABLE(VALUES(Ponto[DATA]),Ponto[Horas Trabalhadas Total Setor] > 0 )
			VAR DATAVALE =
			    AVERAGEX (
			        VALUES ( 'Calendário'[Data] ),
			        CALCULATE (
			            SUM ( FPBI_ABSENTEISMO[QTDABSTENCIA] ),
			            FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR,
			            FPBI_ABSENTEISMO[_Verifica Dia] = 1
			        )
			    )
			VAR TOTVS =
			    AVERAGEX (
			        vr1,
			        CALCULATE (
			            COUNTROWS ( Ponto ),
			            Ponto[_ABSENTEISMO] = "S",
			            'Base Funcionários'[SETOR] IN SETOR,Ponto[Horas Trabalhadas Total Setor] >0
			        ) + 0
			    )
			RETURN
			    IF (
			        SUMX ( 'Calendário', 'Calendário'[_Filtro RH] ) > 0,
			        IF ( [Hora Abate Trabalhadas] <> 0, DATAVALE, BLANK () ),
			        IF ( [Hora Abate Trabalhadas] <> 0, TOTVS, BLANK () )
			    )
		formatString: 0
		displayFolder: 01. Abate
		lineageTag: 8c0029ca-1131-4c05-96fe-389b1b3284f0

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Hora Abate Pausas H:H' =
			
			VAR HORADECIMAL = [Hora Abate Pausas]
			VAR HORA = IF(INT(HORADECIMAL) >= 10, INT(HORADECIMAL), "0"&INT(HORADECIMAL))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) <10, "0"&INT(DIF * 60), INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Abate Pausas]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 01. Abate
		lineageTag: 7e96561f-37d4-415f-b5c4-10f4dad9d13a

	measure 'Hora Abate Almoço H:H' =
			
			VAR HORADECIMAL = [Hora Abate Almoço]
			VAR HORA = IF(ISBLANK(INT(HORADECIMAL)), "00", IF(INT(HORADECIMAL) < 10, "0"&INT(HORADECIMAL) , INT(HORADECIMAL)))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) = 0, INT(DIF * 60)& "0", INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Abate Almoço]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 01. Abate
		lineageTag: 49f949a1-00d0-4226-899f-3d0ce5637393

	measure 'Hora Abate Trabalhada H:H' =
			
			VAR HORADECIMAL = [Hora Abate]
			VAR HORA = IF(ISBLANK(INT(HORADECIMAL)), "00", IF(INT(HORADECIMAL) < 10, "0"&INT(HORADECIMAL) , INT(HORADECIMAL)))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) = 0, INT(DIF * 60)& "0", INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Abate]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 01. Abate
		lineageTag: dfb5d29b-023b-4426-bedc-85f64a5615a3

