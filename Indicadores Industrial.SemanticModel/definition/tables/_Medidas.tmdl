		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04. SubProduto
		lineageTag: 4c297465-7141-4e67-b43e-6ff9bd61ae96

	measure 'Func Graxaria Faltas Base' =
			
			VAR SETOR = { "GRAXARIA" }
			var vr1 = CALCULATETABLE(VALUES(Ponto[DATA]),Ponto[Horas Trabalhadas Total Setor] > 0 )
			
			VAR DATAVALE =
			    AVERAGEX (
			        VALUES ( 'Calendário'[Data] ),
			        CALCULATE (
			            SUM ( FPBI_ABSENTEISMO[QTDABSTENCIA] ),
			            FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR,
			            FPBI_ABSENTEISMO[_Verifica Dia] = 1
			        )
			    )
			VAR TOTVS =
			    AVERAGEX (
			        vr1,
			        CALCULATE (
			            COUNTROWS ( Ponto ),
			            Ponto[_ABSENTEISMO] = "S",
			            'Base Funcionários'[SETOR] IN SETOR, Ponto[Horas Trabalhadas Total Setor] >0
			        ) + 0
			    )
			RETURN
			    IF (
			        SUMX ( 'Calendário', 'Calendário'[_Filtro RH] ) > 0,
			        IF ( [Hora Abate Trabalhadas] <> 0, DATAVALE, BLANK () ),
			        IF ( [Hora Abate Trabalhadas] <> 0, TOTVS, BLANK () )
			    )
		formatString: 0
		displayFolder: 04. SubProduto
		lineageTag: caa494e0-eca8-4510-953d-14556c4b0c16

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '_Formatar Graxaria Rend.' =
			IF(
			    [% Rendimento Graxaria] > [_Meta Rend Graxaria], "#FF0000", "#72ABFD")
		displayFolder: 04. SubProduto
		lineageTag: 4e053c9f-e452-4a1a-ad11-4f8d38fcf268

	measure 'Func Graxaria Ativos' = ```
			
			VAR SETOR = {"GRAXARIA"}
			VAR DATAVALE = AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(FPBI_PONTODIARIO), 
			        FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR ,FPBI_PONTODIARIO[_Verifica Dia] = 1))
			VAR TOTVS =  AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(Ponto), 
			    'Base Funcionários'[SETOR] IN SETOR , Ponto[_QtdFunc] = 1))
			VAR DIAREMPRES = [Func Graxaria Diarista]+[Func Graxaria Emprestimo]
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,IF([Hora Abate Trabalhadas] = BLANK(),BLANK(),DATAVALE),IF([Hora Abate Trabalhadas] = BLANK(),BLANK(),TOTVS))+DIAREMPRES
			```
		formatString: 0
		displayFolder: 04. SubProduto
		lineageTag: a10a6b3a-c067-4c22-8772-a9927e156e33

		annotation PBI_FormatHint = {"isDecimal":true}

