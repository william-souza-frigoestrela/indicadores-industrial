			                    170385.50,
			                    IF(
			                        MAX('Calendário'[Data]) = DATE(2026, 1, 29) &&
			                        MAX(DINVPB_PESOVIVO[NROEMPRESA]) = 104,
			                        159819.8,
			                        IF(
			                            MAX('Calendário'[Data]) = DATE(2026, 2, 2) &&
