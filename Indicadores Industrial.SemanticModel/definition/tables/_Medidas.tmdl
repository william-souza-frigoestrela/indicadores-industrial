	measure 'Hora Abate Pausas Total' = ```
			CALCULATE(
			    SUMX(
			    DINVPB_PAUSATOTAL, 
			    DATEDIFF(DINVPB_PAUSATOTAL[DTAHORAINICIAL], DINVPB_PAUSATOTAL[DTAHORAFINAL], MINUTE) / 60), DINVPB_PAUSATOTAL[TIPO] = "ABATE", DINVPB_PAUSATOTAL[MOTIVO] <> "ABATE EM MODO MANUAL")
			```
		displayFolder: 01. Abate
		lineageTag: 59ad0dee-fb16-4361-b80a-84a3aecdcef7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hora Abate Pausas Total H:H' =
			
			VAR HORADECIMAL = [Hora Abate Pausas Total]
			VAR HORA = IF(INT(HORADECIMAL) >= 10, INT(HORADECIMAL), "0"&INT(HORADECIMAL))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) <10, "0"&INT(DIF * 60), INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Abate Pausas Total]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 01. Abate
		lineageTag: 3db76a8d-b15c-4d54-a533-b06e860d97bf

	measure 'Hora Desossa Pausas Total' = ```
			CALCULATE(
			    SUMX(
			    DINVPB_PAUSATOTAL, 
			    DATEDIFF(DINVPB_PAUSATOTAL[DTAHORAINICIAL], DINVPB_PAUSATOTAL[DTAHORAFINAL], MINUTE) / 60), DINVPB_PAUSATOTAL[TIPO] = "DESOSSA")
			```
		displayFolder: 06. Desossa e Caixaria
		lineageTag: f22f1cda-21fd-4271-8369-0d56290fbaa5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hora Desossa Pausas Total H:H' =
			
			VAR HORADECIMAL = [Hora Desossa Pausas Total]
			VAR HORA = IF(INT(HORADECIMAL) >= 10, INT(HORADECIMAL), "0"&INT(HORADECIMAL))
			VAR DIF = HORADECIMAL - HORA
			VAR MINUTOS = IF(INT(DIF * 60) <10, "0"&INT(DIF * 60), INT(DIF * 60))
			VAR FORMATOTEXTO = FORMAT(HORA & ":" & FORMAT(MINUTOS, "00"), "#00:00")
			VAR FORMATONUM = HORA + (MINUTOS / 100)
			RETURN
			if([Hora Desossa Pausas Total]=BLANK(),BLANK(),FORMATOTEXTO)
		displayFolder: 06. Desossa e Caixaria
		lineageTag: c1a25e6f-9671-46e7-9406-46c0750d0111

