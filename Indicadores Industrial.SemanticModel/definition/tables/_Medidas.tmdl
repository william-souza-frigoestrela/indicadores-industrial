	measure 'Func Miudos Ativos' = ```
			
			VAR SETOR = {"BUCHARIA", "MIUDOS", "BUCHARIA SUJA","BUCHARIA LIMPA", "BUCHARIA - LIMPA", "BUCHARIA - SUJA"} //TROCAR NO PONTO DIARIO TAMBÉM
			VAR DATAVALE = AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(FPBI_PONTODIARIO), 
			        FPBI_FUNCIONARIO[DESCRSETOR] IN SETOR ,FPBI_PONTODIARIO[_Verifica Dia] = 1))
			VAR TOTVS =  AVERAGEX(VALUES('Calendário'[Data]), 
			    CALCULATE(COUNTROWS(Ponto), 
			    'Base Funcionários'[SETOR] IN SETOR , Ponto[_QtdFunc] = 1))
			VAR DIAREMPRES = [Func Miudos Diarista]+[Func Miudos Emprestimo]
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,
			IF([Hora Abate Trabalhadas] = BLANK(),BLANK(),DATAVALE),
			IF([Hora Abate Trabalhadas] = BLANK(),BLANK(),TOTVS))+DIAREMPRES
			```
		formatString: 0
		displayFolder: 02. Miúdos/Bucharia
		lineageTag: c647fa7d-ab0b-4c5e-ad74-76440c0bdc01

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Func Miudos Férias' =
			
			
			var vr1 = CALCULATETABLE(VALUES(Ponto[DATA]),Ponto[Horas Trabalhadas Total Setor] > 0 )
			
			VAR DATAVALE = CALCULATE(AVERAGEX(VALUES('Calendário'[Data]), CALCULATE([Func Miudos Ativos],FPBI_PONTODIARIO[_Ocorrencia Novo] = "Férias", FPBI_PONTODIARIO[_Verifica Dia] = 1)))
			VAR TOTVS = AVERAGEX(vr1, CALCULATE([Func Miudos Ativos], Ponto[FERIAS] = "SIM")) - ([Func Miudos Diarista]+[Func Miudos Emprestimo])
			RETURN
			IF(SUMX('Calendário','Calendário'[_Filtro RH])>0,
			IF([Hora Abate Trabalhadas]<>0,DATAVALE,BLANK()),
			IF([Hora Abate Trabalhadas]<>0,TOTVS,BLANK()))
		displayFolder: 02. Miúdos/Bucharia
		lineageTag: 33f4313e-4e08-4d0d-8a34-c006bc90005b

