	column _Turno =
			IF(
			    DINVPB_PRODUCAOINDUS[DATAHORAENT] >= DINVPB_PRODUCAOINDUS[Entrada] && DINVPB_PRODUCAOINDUS[DATAHORAENT] <= DINVPB_PRODUCAOINDUS[Saída], "Diurno", "Noturno")
		lineageTag: 5bae5434-b42b-49bc-90ff-a88b7274f616
