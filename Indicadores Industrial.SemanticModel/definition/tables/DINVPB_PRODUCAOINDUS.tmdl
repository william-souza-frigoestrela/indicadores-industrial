	partition DINVPB_PRODUCAOINDUS = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source = ```
				let
				    // 1. Conexão SQL nativa no Oracle para Produção de Industrializados (Filiais 2 e 104)
				    Fonte = Oracle.Database("datavale", [
				        HierarchicalNavigation = true, 
				        Query = "
				            SELECT 
				                2 AS NROEMPRESA, 
				                e.* 
				            FROM DINVPB_PRODUCAOINDUSTRIALIZADOS@dtvind02 e 
				            WHERE DATAENT >= '01-JAN-2026'
				
				            UNION ALL
				
				            SELECT 
				                104 AS NROEMPRESA, 
				                e.* 
				            FROM DINVPB_PRODUCAOINDUSTRIALIZADOS@dtvind104 e 
				            WHERE DATAENT >= '01-JAN-2026'
				        "
				    ]),
				
				    // 2. Criação da chave
				    #"Coluna Mesclada Inserida1" = Table.AddColumn(Fonte, "Chave", each Text.Combine({Text.From([NROPROGPRODUCAO], "pt-BR"), [LOTE]}, ""), type text),
				
				    // 3. Ajustes de tipo para manipulação de texto da data
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Coluna Mesclada Inserida1", {{"DATAENT", type date}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Tipo Alterado1", {{"DATAENT", type text}}),
				
				    // 4. Geração de colunas Entrada e Saída
				    #"Personalização Adicionada" = Table.AddColumn(#"Tipo Alterado", "Personalizar", each [DATAENT] & " 05:00:00"),
				    #"Personalização Adicionada1" = Table.AddColumn(#"Personalização Adicionada", "Personalizar.1", each [DATAENT] & " 15:30:00"),
				
				    // 5. Renomeando colunas
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Personalização Adicionada1", {{"Personalizar", "Entrada"}, {"Personalizar.1", "Saída"}}),
				
				    // 6. Conversões finais de tipo
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Colunas Renomeadas", {
				        {"DATAENT", type date}, 
				        {"Entrada", type datetime}, 
				        {"Saída", type datetime}
				    }),
				
				    // 7. Adição da coluna _TIPO
				    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Tipo Alterado2", "_TIPO", each 
				        if Text.Contains([DESCRPRODUTO], "RETRABALHO") then "RETRABALHO" 
				        else if Text.Contains([DESCRPRODUTO], "REPROCESSO") then "RETRABALHO" 
				        else "PRODUÇÃO NORMAL", 
				        type text
				    ),
				
				    // 8. Seleção final das colunas para o modelo
				    #"Columns removed by Measure Killer" = Table.SelectColumns(#"Coluna Condicional Adicionada", {
				        "PESOLIQUIDO",
				        "DATAHORAENT",
				        "NROEMPRESA",
				        "_TIPO",
				        "Entrada",
				        "Saída",
				        "NROPROGPRODUCAO",
				        "DATAENT",
				        "SEQPRODUTO",
				        "DESCRPRODUTO",
				        "LOTE",
				        "DTARENDIMENTO"
				    })
				in
				    #"Columns removed by Measure Killer"
				```

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegação

