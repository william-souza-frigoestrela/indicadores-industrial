	column _Data = ```
			
			VAR DIAANTERIOR = IF(HOUR(DINVPB_PRODUCAOINDUS[DATAHORAENT]) >= 5 && HOUR(DINVPB_PRODUCAOINDUS[DATAHORAENT]) <= 23, DINVPB_PRODUCAOINDUS[DATAENT], DINVPB_PRODUCAOINDUS[DATAENT] -1)
			RETURN 
			DIAANTERIOR
			```
		formatString: General Date
