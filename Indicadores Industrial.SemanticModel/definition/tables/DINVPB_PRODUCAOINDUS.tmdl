	column _DK = DINVPB_PRODUCAOINDUS[NROPROGPRODUCAO]&DINVPB_PRODUCAOINDUS[LOTE]&DINVPB_PRODUCAOINDUS[NROEMPRESA]
		lineageTag: dff25914-fece-4dfd-8233-5d206115a4ce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _Turno =
			IF(
			    DINVPB_PRODUCAOINDUS[DATAHORAENT] >= DINVPB_PRODUCAOINDUS[Entrada] && DINVPB_PRODUCAOINDUS[DATAHORAENT] <= DINVPB_PRODUCAOINDUS[Saída], "Diurno", "Noturno")
		lineageTag: 5bae5434-b42b-49bc-90ff-a88b7274f616
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

