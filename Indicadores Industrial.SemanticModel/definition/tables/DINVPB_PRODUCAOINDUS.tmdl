	partition DINVPB_PRODUCAOINDUS = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source = ```
				let
				    Fonte = PowerPlatform.Dataflows(null),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8" = Workspaces{[workspaceId="d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"]}[Data],
				    #"316346b5-24e3-456e-b119-0fe7250fa321" = #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"{[dataflowId="316346b5-24e3-456e-b119-0fe7250fa321"]}[Data],
				
				    // Novas tabelas
				    MTZ = #"316346b5-24e3-456e-b119-0fe7250fa321"{[entity="DINVPB_PRODUCAOINDUS_MTZ", version=""]}[Data],
				    SLG = #"316346b5-24e3-456e-b119-0fe7250fa321"{[entity="DINVPB_PRODUCAOINDUS_SLG", version=""]}[Data],
				
				    // Combina as tabelas
				    TabelasUnidas = Table.Combine({MTZ, SLG}),
				
				    // Criação da chave
				    #"Coluna Mesclada Inserida1" = Table.AddColumn(TabelasUnidas, "Chave", each Text.Combine({Text.From([NROPROGPRODUCAO], "pt-BR"), [LOTE]}, ""), type text),
				
				    // Ajustes de tipo
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Coluna Mesclada Inserida1",{{"DATAENT", type date}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Tipo Alterado1",{{"DATAENT", type text}}),
				
				    // Geração de colunas Entrada e Saída
				    #"Personalização Adicionada" = Table.AddColumn(#"Tipo Alterado", "Personalizar", each [DATAENT] & " 05:00:00"),
				    #"Personalização Adicionada1" = Table.AddColumn(#"Personalização Adicionada", "Personalizar.1", each [DATAENT] & " 15:30:00"),
				
				    // Renomeando colunas
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Personalização Adicionada1",{{"Personalizar", "Entrada"}, {"Personalizar.1", "Saída"}}),
				
				    // Conversões finais de tipo
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Colunas Renomeadas",{
				        {"DATAENT", type date}, 
				        {"Entrada", type datetime}, 
				        {"Saída", type datetime}
				    }),
				
				    // Adição da coluna _TIPO
				    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Tipo Alterado2", "_TIPO", each 
				        if Text.Contains([DESCRPRODUTO], "RETRABALHO") then "RETRABALHO" 
				        else if Text.Contains([DESCRPRODUTO], "REPROCESSO") then "RETRABALHO" 
				        else "PRODUÇÃO NORMAL"
				    ),
				
				    #"Tipo Alterado3" = Table.TransformColumnTypes(#"Coluna Condicional Adicionada",{{"_TIPO", type text}})
				in
				    #"Tipo Alterado3"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

