	column '_Horas Trabalhadas' = DIVIDE(Ponto[HTRAB], 60)
		lineageTag: ca8446dd-2dc0-4178-bbde-7c64e1bb6029
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_Verifica Dia' = ```
			
			VAR ABATE = CALCULATE(
			    MAX(FPBI_RESUMOABATE[DATA]), 
			    FILTER(
			    FPBI_RESUMOABATE, 
			    FPBI_RESUMOABATE[DATA] = Ponto[DATA]))
			VAR MIUDOS = CALCULATE(
			    MAX(FPBI_RESUMOABATE[DATA]), 
			    FILTER(
			    FPBI_RESUMOABATE, 
			    FPBI_RESUMOABATE[DATA] = Ponto[DATA]))
			VAR DESOSSA = CALCULATE(
			    MAX(DINVPB_ENTRADADESOSSA[DTARENDIMENTO]), 
			    FILTER(
			    DINVPB_ENTRADADESOSSA, 
			    DINVPB_ENTRADADESOSSA[DTARENDIMENTO] = Ponto[DATA]))
			VAR INDUS = CALCULATE(
			    MAX(DINVPB_PRODUCAOINDUS[DTARENDIMENTO]),
			    FILTER(
			    DINVPB_PRODUCAOINDUS, 
			    DINVPB_PRODUCAOINDUS[DTARENDIMENTO] = Ponto[DATA]))
			RETURN
			IF(
			SWITCH(
			    TRUE(),
			    Ponto[SETOR] IN {"CURRAL","POCILGA", "NATURA AREA QUENTE", "NATURA ÁREA QUENTE","NATURA AREA QUENTE","IN NATURA AREA QUENTE","TRIPARIA","BUCHARIA"}, Ponto[DATA] = ABATE,
			    Ponto[SETOR] IN {"BUCHARIA", "MIUDOS", "BUCHARIA SUJA","BUCHARIA LIMPA", "BUCHARIA - LIMPA", "BUCHARIA - SUJA"}, Ponto[DATA] = MIUDOS,
			    Ponto[SETOR] IN {"DESOSSA", "CAIXARIA", "DESOSSA DIURNO", "DESOSSA NOTURNO", "DESOSSA DIURNA", "DESOSSA NOTURNA", "CAIXARIA DIURNA", "CAIXARIA NOTURNA", "CAIXARIA NOTURNO", "CAIXARIA NOTURNO","CORTE", "CORTE"}, Ponto[DATA] = DESOSSA,
			    Ponto[DEPARTAMENTO] IN {"INDUSTRIA INDUSTRIALIZADOS","INDUSTRIA EMBUTIDOS"," INDUSTRIA INDUSTRIALIZADOS"}, Ponto[DATA] = INDUS) = TRUE(), 1, 0)
			```
		formatString: 0
		lineageTag: c84f5068-41d5-4a32-910e-190db0c07241
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '_Verifica Demissão' =
			
			SWITCH(
			    TRUE(),
			    Ponto[DATA] >= Ponto[DATAADMISSAO],1,
			    Ponto[DATA] <= Ponto[DATADEMISSAO],1,
			    0)
		formatString: 0
		lineageTag: 0566acf6-de66-4445-9255-1dd708fb3006
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

