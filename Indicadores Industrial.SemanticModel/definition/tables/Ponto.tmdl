	column _ABSENTEISMO = ```
			
			              IF(Ponto[HTRAB] > 0, "N",
			              IF(Ponto[DESCANSO] >0,"N",
			              IF(Ponto[FERIADO] >0 , "N",
			              IF(Ponto[DIAS] < 15 && Ponto[DIAS] > 0, "S",
			              IF(Ponto[DIAS] >= 15,"N",
			              IF(Ponto[ATRASO] = Ponto[BASE] && Ponto[BASE] > 0, "S",
			              IF(Ponto[FALTA] = Ponto[BASE] && Ponto[BASE] > 0, "S",
			              IF(Ponto[CODABONO] IN {"0000","0002","0003","0013","0016","0020","0022","0014","0005"},"S",
			              IF(Ponto[CODABONO] IN {"0021","0008","0018","0007","0006"},"N",
			              IF(Ponto[CODABONO] = "0023" && Ponto[DATA] = Ponto[DATADEMISSAO],"N",
			              IF(Ponto[CODABONO] = "0023" && Ponto[DATA] <> Ponto[DATADEMISSAO],"S",
			              IF(Ponto[BASE] = 0 && Ponto[CODSITUACAO] IN {"A","V","Q","F"} ,"N",
			              IF(Ponto[BASE] = 0,"N",
			"")))))))))))))
			```
		lineageTag: 8dc0e0d0-db48-4041-becb-7c19b85a1424
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _QtdFunc = IF(Ponto[DIAS] >= 15, 0 ,1)
		formatString: 0
