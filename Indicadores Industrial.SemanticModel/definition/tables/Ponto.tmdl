	partition Ponto-c24a0e2a-c890-468e-a626-ac6e6372a317 = m
		mode: import
		queryGroup: 'Ponto Funcionário'
		source = ```
				let
				    // 1. Conexão SQL nativa no Oracle trazendo a tabela de Ponto filtrada a partir de 2026
				    Fonte = Oracle.Database("DATAVALE", [
				        Query = "SELECT * FROM DATAVALE.FPBI_PONTOFLOWRM WHERE DATA >= '01-JAN-2026'", 
				        HierarchicalNavigation = true
				    ]),
				
				    // 2. Filtro das filiais especificadas
				    #"Linhas Filtradas" = Table.SelectRows(Fonte, each ([CODFILIAL] = 2 or [CODFILIAL] = 4 or [CODFILIAL] = 12 or [CODFILIAL] = 104 or [CODFILIAL] = 27 or [CODFILIAL] = 18 or [CODFILIAL] = 72)),
				
				    // 3. Adição da coluna condicional _Turno
				    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Linhas Filtradas", "_Turno", each if Text.Contains([SECAO], "2º TURNO") then "Noturno" else if Text.Contains([SECAO], "2") then "Noturno" else "Diurno", type text),
				
				    // 4. Tratamento de texto para remover códigos/delimitadores iniciais
				    #"Texto Extraído Após o Delimitador" = Table.TransformColumns(#"Coluna Condicional Adicionada", {
				        {"DEPARTAMENTO", each Text.AfterDelimiter(_, " "), type text}, 
				        {"SETOR", each Text.AfterDelimiter(_, " "), type text}, 
				        {"SECAO", each Text.AfterDelimiter(_, " "), type text}
				    }),
				
				    // 5. Seleção final das colunas para o modelo
				    #"Columns removed by Measure Killer" = Table.SelectColumns(#"Texto Extraído Após o Delimitador", {
				        "ABSENTEISMOFALTA",
				        "DATAADMISSAO",
				        "HTRAB",
				        "FERIADO",
				        "DESCRICAO",
				        "DEPARTAMENTO",
				        "EXTRAAUTORIZADO",
				        "FALTA",
				        "CODFILIAL",
				        "ABONO",
				        "CODSITUACAO",
				        "FERIAS",
				        "DESCANSO",
				        "DATA",
				        "ATRASO",
				        "SETOR",
				        "BASE",
				        "_Turno",
				        "ABSENTEISMOATESTADO",
				        "CHAPA",
				        "ADICIONAL",
				        "DIAS",
				        "CODABONO",
				        "DATADEMISSAO",
				        "EXTRAEXECUTADO"
				    })
				in
				    #"Columns removed by Measure Killer"
				```

