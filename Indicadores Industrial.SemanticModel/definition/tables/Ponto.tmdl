	column '_Horas Atraso' = DIVIDE(Ponto[ATRASO],60,0)
		lineageTag: 3e411c74-b6e0-4b3f-a8b1-2f36e8e954f2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_Horas Extras Ad.Noturno' = DIVIDE(Ponto[ADICIONAL],60,0)
		lineageTag: aed7984b-8f3f-421f-ba35-f3115c312002
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column TipoAbseteismo =
			
			IF(Ponto[DIAS] >= 15,"AFASTAMENTO",
			IF(Ponto[ATRASO] = Ponto[BASE] && Ponto[BASE] > 0 && Ponto[ABSENTEISMOATESTADO] = "NAO" && Ponto[FERIAS] = "NAO" && Ponto[ABSENTEISMOFALTA] = "NAO" && Ponto[CODABONO] = BLANK(),"ATRASO/FALTA",
			IF(Ponto[ATRASO] > 0 && Ponto[EXTRAAUTORIZADO] = 0 && Ponto[BASE] > 0 && Ponto[ABSENTEISMOATESTADO] = "NAO" && Ponto[FERIAS] = "NAO" && Ponto[ABSENTEISMOFALTA] = "NAO" && Ponto[CODABONO] = BLANK(),"ATRASO",
			IF(Ponto[ATRASO] > 0 && Ponto[EXTRAAUTORIZADO] > 0 && Ponto[BASE] > 0 && Ponto[ABSENTEISMOATESTADO] = "NAO" && Ponto[FERIAS] = "NAO" && Ponto[ABSENTEISMOFALTA] = "NAO","ATRASO ERRADO",
			IF(Ponto[ABSENTEISMOFALTA] = "SIM","FALTA",
			IF(Ponto[FERIAS] = "SIM","FERIAS",
			IF(Ponto[DESCRICAO] <> BLANK(), Ponto[DESCRICAO],
			IF(Ponto[ATRASO] = 0 && Ponto[HTRAB] = 0 && Ponto[BASE] = 0 && Ponto[DESCANSO] = 0, "SEM JORNADA",
			IF(Ponto[ATRASO] = 0 && Ponto[HTRAB] = 0 && Ponto[BASE] = 0 && Ponto[DESCANSO] > 0, "SEM JORNADA",
			IF(Ponto[DESCANSO] > 0 && Ponto[EXTRAEXECUTADO] > 0,"TRABALHO EM DIA SEM JORNADA",
			IF(Ponto[FERIADO] > 0 && Ponto[BASE] = 0 && Ponto[EXTRAEXECUTADO] > 0 , "TRABALHO NO FERIADO",
			IF(Ponto[ATRASO] = 0 && Ponto[EXTRAEXECUTADO] > 0 && Ponto[BASE] > 0 , "HR EXTRA NO DIA",
			IF(Ponto[EXTRAEXECUTADO] > 0 && Ponto[BASE] = 0 , "TRABALHO EM DIA SEM JORNADA",
			IF(Ponto[HTRAB] < Ponto[BASE] && Ponto[ABSENTEISMOATESTADO] = "NAO" && Ponto[CODABONO] = BLANK(), "ATRASO",
			IF(Ponto[HTRAB] = Ponto[BASE], "JORNADA NORMAL",
			IF(Ponto[HTRAB] > Ponto[BASE], "EXTRA DENTRO DE 10 MIN",
			IF(Ponto[ABSENTEISMOATESTADO] = "SIM","ATESTADO MEDICO",
			
			"CLASSIFICAR")))))))))))))))))
		lineageTag: ff97b291-a3c2-4dd2-b922-e362da891e87
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _HrsAbsenteismo =
			
			IF(Ponto[TipoAbseteismo] = "ATESTADO DE HORAS", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "ATESTADO JUDICIAL", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "ATESTADO MEDICO" && Ponto[DIAS] < 15, Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "ATESTADO" && Ponto[DIAS] < 15, Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "ATESTADO OBITO", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "DECLARACAO DE COMPARECIMENTO", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "INTERNACAO CONJUGE", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "LICENCA PATERNIDADE", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "LICENCA MATRIMONIAL", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "PROVAS ESCOLARES/VESTIBULAR", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "PRESTAÇÃO SERVIÇO COMUNITARIO", Ponto[ABONO],
			IF(Ponto[TipoAbseteismo] = "FALTA", Ponto[FALTA],
			0))))))))))))
		formatString: 0
		lineageTag: 5705b9a2-e60f-409f-8d05-641fbb22e840
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _Classificação =
			
			IF(
			    Ponto[TipoAbseteismo] IN {
			        "ATESTADO DE HORAS",
			        "ATESTADO JUDICIAL",
			        "ATESTADO OBITO",
			        "LICENCA MATRIMONIAL",
			        "LICENCA PATERNIDADE",
			        "PRESTAÇÃO SERVIÇO COMUNITARIO",
			        "PROVAS ESCOLARES/VESTIBULAR"
			    }, "Legal",
			IF(
			    Ponto[TipoAbseteismo] IN {
			        "DECLARACAO DE COMPARECIMENTO",
			        "FALTA"
			    }, "Injustificado",
			IF(
			    Ponto[TipoAbseteismo] IN {
			        "ATESTADO MEDICO",
			        "INTERNACAO CONJUGE"
			    }, "Médico",
			"Não Entra")))
		lineageTag: 890fc3bd-0bf5-43c5-9d24-469386678e96
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Horas Trabalhadas Total Setor' =
			
