		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Valor Funrural' = DCUVQ_COMPRAGADOPRAZO[VLRPRODUTO] * DCUVQ_COMPRAGADOPRAZO[Funrural]
		lineageTag: 42861906-6b32-4ae3-8660-aef651fdd872
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column pk = DCUVQ_COMPRAGADOPRAZO[NROEMPRESA]&DCUVQ_COMPRAGADOPRAZO[NROPEDIDO]
		lineageTag: 9b28187b-5e81-47fc-82bf-3dad6caa3d53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _VlrCompra =
			
			VAR COMPRAEMP4 = CALCULATE(SUM('EXCEL_COMPLEMENTOAUX'[Valor Complemento]),
			    FILTER('EXCEL_COMPLEMENTOAUX',
			    'EXCEL_COMPLEMENTOAUX'[Data Abate] = DCUVQ_COMPRAGADOPRAZO[DATATESTE] &&
			    'EXCEL_COMPLEMENTOAUX'[Nro Empresa] = DCUVQ_COMPRAGADOPRAZO[NROEMPRESA] &&
			    'EXCEL_COMPLEMENTOAUX'[Nro Pedido] = DCUVQ_COMPRAGADOPRAZO[NROPEDIDO]))
			RETURN
			    SWITCH(
			        TRUE(), DCUVQ_COMPRAGADOPRAZO[NROEMPRESA] = 4,COMPRAEMP4,0)
		lineageTag: e37e8646-1245-44f7-b21a-31304b32c97a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column _ValorCompraProp = ```
			
			VAR COMPRA  = CALCULATE(
			    SUM(DCUVQ_COMPRAGADOPRAZO[VLRPRODUTO]),
			    ALLEXCEPT(DCUVQ_COMPRAGADOPRAZO,DCUVQ_COMPRAGADOPRAZO[NROPEDIDO],DCUVQ_COMPRAGADOPRAZO[DATATESTE],DCUVQ_COMPRAGADOPRAZO[NROEMPRESA]))
			VAR QUANTIDADE = CALCULATE(
			    SUM(DCUVQ_COMPRAGADOPRAZO[QUANTIDADE]),
			    ALLEXCEPT(DCUVQ_COMPRAGADOPRAZO,DCUVQ_COMPRAGADOPRAZO[NROPEDIDO],DCUVQ_COMPRAGADOPRAZO[DATATESTE],DGE_EMPRESAMATRIZ[NROEMPRESA]))
			VAR PROP = DIVIDE(DCUVQ_COMPRAGADOPRAZO[QUANTIDADE],QUANTIDADE)
			RETURN IF(DCUVQ_COMPRAGADOPRAZO[_VlrCompra] > 0, PROP)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 397ef172-f78c-459c-a1e3-c384399fb40a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '_Valor Complemento' = DCUVQ_COMPRAGADOPRAZO[_VlrCompra]*DCUVQ_COMPRAGADOPRAZO[_ValorCompraProp]
		lineageTag: 80552e74-6a97-4ce3-9c8c-1ef846fbfe7e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

