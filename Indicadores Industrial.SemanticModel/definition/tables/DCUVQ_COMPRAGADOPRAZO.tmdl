	column _Pesovivocomplemento =
			
			VAR PESOEMP4 = CALCULATE(SUM('EXCEL_PESOVIVOAUX'[Peso Vivo Graxaria]),
			    FILTER('EXCEL_PESOVIVOAUX',
			    'EXCEL_PESOVIVOAUX'[Data] = DCUVQ_COMPRAGADOPRAZO[DATATESTE] &&
			    'EXCEL_PESOVIVOAUX'[Nro Empresa] = DCUVQ_COMPRAGADOPRAZO[NROEMPRESA] &&
			    'EXCEL_PESOVIVOAUX'[Nro Pedido] = DCUVQ_COMPRAGADOPRAZO[NROPEDIDO]))
			RETURN
			    SWITCH(
			        TRUE(), DCUVQ_COMPRAGADOPRAZO[NROEMPRESA] = 4,PESOEMP4,0)
		lineageTag: 17c04dc1-952a-48d7-9137-10e24eac6403
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column _PesovivoProp = ```
			
			VAR COMPRA  = CALCULATE(
			    SUM(DCUVQ_COMPRAGADOPRAZO[VLRPRODUTO]),
			    ALLEXCEPT(DCUVQ_COMPRAGADOPRAZO,DCUVQ_COMPRAGADOPRAZO[NROPEDIDO],DCUVQ_COMPRAGADOPRAZO[DATATESTE],DCUVQ_COMPRAGADOPRAZO[NROEMPRESA]))
			VAR QUANTIDADE = CALCULATE(
			    SUM(DCUVQ_COMPRAGADOPRAZO[QUANTIDADE]),
			    ALLEXCEPT(DCUVQ_COMPRAGADOPRAZO,DCUVQ_COMPRAGADOPRAZO[NROPEDIDO],DCUVQ_COMPRAGADOPRAZO[DATATESTE],DGE_EMPRESAMATRIZ[NROEMPRESA]))
			VAR PROP = DIVIDE(DCUVQ_COMPRAGADOPRAZO[QUANTIDADE],QUANTIDADE)
			RETURN IF(DCUVQ_COMPRAGADOPRAZO[_Pesovivocomplemento] > 0, PROP)
			
			```
