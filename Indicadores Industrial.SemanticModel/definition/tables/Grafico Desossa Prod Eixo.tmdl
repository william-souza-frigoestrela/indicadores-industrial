table 'Grafico Desossa Prod Eixo'
	lineageTag: 4656ef75-eec3-48a6-bcf2-cd098020eb9b

	measure '_Intervalo Datas Desossa (alternativa)' = ```
			
			VAR Tipo = SELECTEDVALUE ( 'Grafico Desossa Prod Eixo'[Tipo] )
			VAR Rot  = SELECTEDVALUE ( 'Grafico Desossa Prod Eixo'[Rotulo] )
			VAR Hoje = TODAY()
			VAR Ano  = YEAR ( Hoje )
			VAR Mes  = MONTH ( Hoje )
			RETURN
			SWITCH (
			    TRUE(),
			    Tipo = "Mes",
			        VAR MesNum =
			            SWITCH ( Rot,
			                "jan",1,"fev",2,"mar",3,"abr",4,"mai",5,"jun",6,
			                "jul",7,"ago",8,"set",9,"out",10,"nov",11,"dez",12
			            )
			        VAR InicioMes = DATE ( Ano, MesNum, 1 )
			        VAR FimMes    = EOMONTH ( InicioMes, 0 )
			        RETURN DATESBETWEEN ( 'Calendário'[Data], InicioMes, FimMes ),
			
			    Tipo = "Dia",
			        VAR DiaNum = VALUE ( Rot )
			        VAR DataAlvo = DATE ( Ano, Mes, DiaNum )
			        RETURN DATESBETWEEN ( 'Calendário'[Data], DataAlvo, DataAlvo )
			)
			
			```
		formatString: General Date
		lineageTag: 4826d580-3c65-4a89-8ad3-c3b0367219eb

	measure MetaDiaGrafDesossa =
			
			
			VAR Tipo = SELECTEDVALUE ( 'Grafico Desossa Prod Eixo'[Tipo] )
			RETURN
			IF (
			    Tipo = "Dia",
			    VAR Rot      = SELECTEDVALUE ( 'Grafico Desossa Prod Eixo'[Rotulo] )
			    VAR DiaNum   = VALUE ( Rot )
			    VAR AnoSel   = SELECTEDVALUE ( 'Calendário'[Ano],   YEAR ( TODAY() ) )
			    VAR MesSel   = SELECTEDVALUE ( 'Calendário'[MesNo], MONTH ( TODAY() ) )
			    VAR DataAlvo = DATE ( AnoSel, MesSel, DiaNum )
			    VAR FimMes   = EOMONTH ( DATE ( AnoSel, MesSel, 1 ), 0 )
			
			    VAR RealNoDia =
			        CALCULATE ( [RealDiaGrafDesossa], DATESBETWEEN ( 'Calendário'[Data], DataAlvo, DataAlvo ) )
			
			    VAR MetaNoDia =
			        CALCULATE ( [Valor Meta],  DATESBETWEEN ( 'Calendário'[Data], DataAlvo, DataAlvo ) )
			
			    RETURN
			        IF (
			            DataAlvo > FimMes || ISBLANK(RealNoDia) || RealNoDia = 0,
			            BLANK(),                    -- sem produção: não plota (eixo limpa a categoria)
			            COALESCE ( MetaNoDia, 0 )   -- com produção e sem meta: plota 0 (linha contínua, sem pico)
			        )
			)
		lineageTag: bf25e153-c4ed-438d-abc3-3361add833c9

	measure 'MetaDiaGrafDesossa (reescalada)' = ```
			
			VAR MaxColunaNoContexto =
			    CALCULATE(
			        MAXX(
			            VALUES('Grafico Desossa Prod Eixo'[Rotulo]),
			            [SerieRealDiaGrafDesossa]  -- suas colunas (real dia)
			        ),
			        ALLSELECTED('Grafico Desossa Prod Eixo'),
			        KEEPFILTERS('Grafico Desossa Prod Eixo'[Tipo] = "Dia")
			    )
			VAR MaxMetaNoContexto =
			    CALCULATE(
			        MAXX(
			            VALUES('Grafico Desossa Prod Eixo'[Rotulo]),
			            [MetaDiaGrafDesossa]       -- sua meta diária original (sem reescala)
			        ),
			        ALLSELECTED('Grafico Desossa Prod Eixo'),
			        KEEPFILTERS('Grafico Desossa Prod Eixo'[Tipo] = "Dia")
			    )
			VAR Fator =
			    VAR f = DIVIDE(MaxColunaNoContexto, MaxMetaNoContexto)
			    RETURN IF( ISBLANK(f) || f = 0, 1, f )  -- fallback: evita linha sumir
			VAR ValorMeta = [MetaDiaGrafDesossa]               -- valor da meta no ponto atual
			RETURN
			IF(
			    SELECTEDVALUE('Grafico Desossa Prod Eixo'[Tipo]) = "Dia",
			    COALESCE( ValorMeta * Fator, 0 ),       -- plota 0 (não BLANK) para manter linha contínua
			    BLANK()                                 -- não plota nos rótulos de "Mes"
			)
			
			
			```
		lineageTag: 2b3c11e7-4f6f-4f86-b0d3-c0619263b2e9

	measure RealAcumMesGrafDesossa =
			
			CALCULATE([Realizado], DATESYTD('Calendário'[Data]))
		lineageTag: a911a7c8-3f3d-4ea3-8066-aa325d3c2cfd

