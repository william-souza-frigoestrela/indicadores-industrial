	partition 'Grafico Abate Prod Eixo' = calculated
		mode: import
		source = ```
				
				
				VAR Meses =
				    SELECTCOLUMNS (
				        GENERATESERIES ( 1, 12, 1 ),
				        "Tipo",   "Mes",
				        "Rotulo", SWITCH ( [Value],
				                    1,"jan", 2,"fev", 3,"mar", 4,"abr",
				                    5,"mai", 6,"jun", 7,"jul", 8,"ago",
				                    9,"set", 10,"out", 11,"nov", 12,"dez"
				                 ),
				        "Ordem",  [Value]
				    )
				VAR Dias =
				    SELECTCOLUMNS (
				        GENERATESERIES ( 1, 31, 1 ),
				        "Tipo",   "Dia",
				        "Rotulo", FORMAT ( [Value], "0" ),
				        "Ordem",  100 + [Value]
				    )
				RETURN
				    UNION ( Meses, Dias )
				
				```

