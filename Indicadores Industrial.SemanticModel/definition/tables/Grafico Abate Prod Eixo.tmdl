	measure IndiceEscala = ```
			// 10
			
			VAR Meta = [Meta Indicador]
			RETURN
			IF(
			    Meta = 0,
			    1,
			    10
			)
			
			```
		formatString: 0
		lineageTag: 9e4c65a0-b872-417e-bd49-0809deec643c

	measure 'SerieRealMesGraf Ajuste' = ```
			
			
			VAR Tipo = SELECTEDVALUE( 'Grafico Abate Prod Eixo'[Tipo] )
			VAR RealMes = [SerieRealMesGraf]        -- valor mensal REAL
			VAR Ajustado = DIVIDE( RealMes, [IndiceEscala] )
			RETURN
			    IF(
			        Tipo = "Mes" && NOT ISBLANK(RealMes),
			        Ajustado,
			        BLANK()
			    )
			
			```
		lineageTag: 84696919-e026-4905-bdf6-ea2a6b76294e

