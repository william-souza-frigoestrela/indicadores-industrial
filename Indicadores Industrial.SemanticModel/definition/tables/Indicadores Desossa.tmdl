table 'Indicadores Desossa'
	lineageTag: eae5aae4-44f0-469e-b362-5d40f402ae66

	measure ValorIndicadorLinhaDesossa = ```
			
			
			VAR ind = SELECTEDVALUE('Indicadores Desossa'[IndicadorDesossa])
			RETURN
			SWITCH(
			    ind,
			    "Peças Processadas Grossa",     [Peças Processadas Desossa],
			    "Peças Processadas PA",         [Peças Desossa PA],
			    "Peso Entrada (Ton)",           [Peso Entrada Desossa]/1000,
			    "Peso Saída (Ton)",             [Peso Saída Desossa]/1000,
			    "% Rendimento Desossa Massa",   [_% Rendimento TR/DT],
			    "% Rendimento PA",              [_% Rendimento PA Massa],
			    "% Rendimento Traseiro",        [_% Rendimento TR Massa],
			    "% Rendimento Dianteiro",       [_% Rendimento DT Massa],    
			    "% Proporção MI",              [% Mercado MI],
			    "% Proporção ME",               [% Mercado ME], 
			    "% Eficiência Desossa",         [Eficiência Desossa],
			    "Produtivudade (Pç/Hhr)",       [Produtividade Desossa Pç/Hh],
			    "Produtividade (Kg/Hhr)",       [Produtividade Desossa Kg/HHr],
			    "% Absenteismo",                [Func Desossa Absenteismo],
			
			    BLANK()
			)
			
			```
		lineageTag: 8425afc1-3040-4744-be56-2c809f01fd0b

		formatStringDefinition =
				VAR _un = SELECTEDVALUE('Indicadores Desossa'[Un])
				
				RETURN
				LOOKUPVALUE(UnidadeInidicadores[Formato], UnidadeInidicadores[Unidade], _un, "#,##0.00" --Fornato padrão caso não encontre
				)

	measure 'Valor Indicador Deossa' =
			
			VAR tipo = SELECTEDVALUE(TipoValor[Tipo])
			RETURN
			IF( tipo = "Meta", [Meta Indicador], [ValorIndicadorLinhaDesossa] )
		lineageTag: 5d651fc3-c94a-432e-8b74-fcbd80a9b570

		formatStringDefinition =
				VAR _un = SELECTEDVALUE('Indicadores Desossa'[Un])
				
				RETURN
				LOOKUPVALUE(UnidadeInidicadores[Formato], UnidadeInidicadores[Unidade], _un, "#,##0.00" --Fornato padrão caso não encontre
				)

