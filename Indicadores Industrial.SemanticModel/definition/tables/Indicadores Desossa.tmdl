	partition 'Indicadores Desossa' = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "IndicadorDesossa", STRING,
				    "Un", STRING,
				    "Ordem", INTEGER,
				    {
				        {"Peças Processadas Grossa","Qtde", 0},
				        {"Peças Processadas PA","Qtde",1},
				        {"Peso Entrada (Ton)","Ton", 2},
				        {"Peso Saída (Ton)","Ton", 3},
				        {"% Rendimento Desossa Massa","%", 4},
				        {"% Rendimento PA","%",5},
				        {"% Rendimento Traseiro","%",6},
				        {"% Rendimento Dianteiro","%",7},
				        {"% Proporção MI","%",8},
				        {"% Proporção ME","%",9},
				        {"% Eficiência Desossa","%",10},
				        {"Produtivudade (Pç/Hhr)","Pç/Hhr",11},
				        {"Produtividade (Kg/Hhr)","Kg/Hhr",12},
				        {"% Absenteismo","%",13}
				
				    }
				)
				
				```

