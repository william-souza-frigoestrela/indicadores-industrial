	column _DataHoraMax = ```
			
			var var01 = 
			CALCULATE(
			    MAX(DINVPB_PRODUCAODESOSSA[DATAHORAENT]), 
			    ALLEXCEPT(DINVPB_PRODUCAODESOSSA, DINVPB_PRODUCAODESOSSA[DTARENDIMENTO], DEPARADESOSSA[NROEMPRESA], DINVPB_PRODUCAODESOSSA[_Turno]), 
			        DINVPB_PRODUCAODESOSSA[_Verificação] = "Considerar", 
			            DINVPB_PRODUCAODESOSSA[_Verificação 2]  in {-1,0,1})
			RETURN
			var01
			```
		lineageTag: 3e91044e-d20e-4a34-b0e9-3fa1742e0c16
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _DataHoraMin = ```
			
			var var01 = 
			CALCULATE(
			    MIN(DINVPB_PRODUCAODESOSSA[DATAHORAENT]), 
			    ALLEXCEPT(DINVPB_PRODUCAODESOSSA, DINVPB_PRODUCAODESOSSA[DTARENDIMENTO], DEPARADESOSSA[NROEMPRESA], DINVPB_PRODUCAODESOSSA[_Turno]), 
			        DINVPB_PRODUCAODESOSSA[_Verificação] = "Considerar", 
			            DINVPB_PRODUCAODESOSSA[_Verificação 2]  in {-1,0,1})
			RETURN
			var01
			```
		lineageTag: 4efa7f1a-c468-4fd9-bf56-45186908d601
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_Verificação 2' = DATEDIFF(DATE(YEAR(DINVPB_PRODUCAODESOSSA[DATAHORAENT]),MONTH(DINVPB_PRODUCAODESOSSA[DATAHORAENT]),day(DINVPB_PRODUCAODESOSSA[DATAHORAENT])),DINVPB_PRODUCAODESOSSA[DATAHORAENT],DAY)
		formatString: 0
