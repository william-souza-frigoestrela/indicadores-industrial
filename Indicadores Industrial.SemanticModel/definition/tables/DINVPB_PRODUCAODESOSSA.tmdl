	column '_Meta Pçs/H Desossa' = ```
			
			SWITCH(
			    TRUE(),
			    DINVPB_PRODUCAODESOSSA[NROEMPRESA] = 2, 500,
			    DINVPB_PRODUCAODESOSSA[NROEMPRESA] = 104, 380,
			    DINVPB_PRODUCAODESOSSA[NROEMPRESA] = 4, 260, BLANK())   
			```
