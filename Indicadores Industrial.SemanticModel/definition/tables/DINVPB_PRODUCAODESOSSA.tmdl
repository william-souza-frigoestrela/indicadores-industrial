	partition DINVPB_PRODUCAODESOSSA-2c87737b-dc80-4c6a-a832-3c59abdbef6a = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source =
				let
				    // 1. Conexão SQL nativa unificando as instâncias de Produção Desossa no Oracle com NROEMPRESA fixo
				    Fonte = Oracle.Database("datavale", [HierarchicalNavigation=true, Query="#(lf)            SELECT #(lf)                2 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_PRODUCAODESOSSA@dtvind02 e #(lf)            WHERE DTARENDIMENTO >= TRUNC(SYSDATE)-90#(lf)            #(lf)            UNION ALL#(lf)            #(lf)            SELECT #(lf)                4 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_PRODUCAODESOSSA@dtvind04 e #(lf)            WHERE DTARENDIMENTO >= TRUNC(SYSDATE)-90#(lf)            #(lf)            UNION ALL#(lf)            #(lf)            SELECT #(lf)                104 AS NROEMPRESA, #(lf)                e.* #(lf)            FROM DINVPB_PRODUCAODESOSSA@dtvind104 e #(lf)            WHERE DTARENDIMENTO >= TRUNC(SYSDATE)-90#(lf)        "]),
				
				    // 2. Colunas Condicionais de Negócio
				    #"Coluna Condicional Adicionada" = Table.AddColumn(Fonte, "_Mercado", each if Text.Contains([DESCRSUBGRUPOPRODUTO], "EXP") then "ME" else "MI", type text),
				    #"Coluna Condicional Adicionada1" = Table.AddColumn(#"Coluna Condicional Adicionada", "_ProdutoChina", each if Text.Contains([DESCRPRODUTO], "CHINA") then "CHN" else null, type text),
				    #"Coluna Condicional Adicionada2" = Table.AddColumn(#"Coluna Condicional Adicionada1", "_DIVIDO", each if Text.Contains([DESCRPRODUTO], "AO MEIO") then 2 else null, type number),
				    #"Coluna Condicional Adicionada3" = Table.AddColumn(#"Coluna Condicional Adicionada2", "_ProdutoFilipinas", each if Text.Contains([DESCRPRODUTO], "FILIPINAS") then "FILIPINAS" else null, type text),
				    #"Coluna Condicional Adicionada4" = Table.AddColumn(#"Coluna Condicional Adicionada3", "_ProdutoSingapura", each if Text.Contains([DESCRPRODUTO], "SINGAPURA") then "SINGAPURA" else null, type text),
				    #"Coluna Condicional Adicionada5" = Table.AddColumn(#"Coluna Condicional Adicionada4", "_ProdutoEuropa", each if Text.Contains([DESCRPRODUTO], "U.E") then "Europa" else null, type text),
				    #"Coluna Condicional Adicionada6" = Table.AddColumn(#"Coluna Condicional Adicionada5", "_ProdutoPeru", each if Text.Contains([DESCRPRODUTO], "PERU") then "Peru" else null, type text),
				
				    // 3. Renomeação de Coluna e Filtros
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Coluna Condicional Adicionada6", {{"PESOLIQUIDO", "PESOLIQUIDOSAIDA"}}),
				    #"Linhas Filtradas" = Table.SelectRows(#"Colunas Renomeadas", each Text.From([LOTE]) <> "19"),
				
				    // 4. Seleção final das colunas para o modelo
				    #"Columns removed by Measure Killer" = Table.SelectColumns(#"Linhas Filtradas", {
				        "NROPROGPRODUCAO",
				        "_ProdutoSingapura",
				        "PESOLIQUIDOSAIDA",
				        "SEQPRODUTO",
				        "LOTE",
				        "DESCRPRODUTO",
				        "_ProdutoChina",
				        "_ProdutoPeru",
				        "DTARENDIMENTO",
				        "QTDEMBALAGEM",
				        "_ProdutoEuropa",
				        "DATAHORAENT",
				        "NROEMPRESA",
				        "DESCRGRUPOPRODUTO",
				        "UNIDADE",
				        "_DIVIDO",
				        "DESCRFAMILIA",
				        "QUANTIDADE2",
				        "TIPOPRODUTO",
				        "DESCRSUBGRUPOPRODUTO",
				        "_ProdutoFilipinas",
				        "_Mercado"
				    })
				in
				    #"Columns removed by Measure Killer"

