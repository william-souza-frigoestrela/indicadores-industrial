	measure 'Var% Graf' = [AtingmentoMeta] + ([Variação%])
		lineageTag: 62e38f4b-60b1-4c21-b63e-565eeeb2b6bf

		formatStringDefinition = "0.00%"

	measure Variacao =
			
			VAR real = [Realizado]
			VAR meta = [Meta Indicador]
			RETURN
			IF(
			    ISBLANK(real) || ISBLANK(meta),
			    BLANK(),
			    real - meta
			)
		formatString: 0.00
		lineageTag: f4d08b96-7988-45ef-b282-51743d0e75de

	measure Variação% = ```
			
			VAR real = [Realizado]
			VAR meta = [Meta Indicador]
			RETURN
			IF(
			    ISBLANK(real) || ISBLANK(meta) || meta = 0,
			    BLANK(),
			    DIVIDE( real - meta, meta )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 48c318f4-08c8-48f1-b00a-6b7331bba7f1

	measure VariacaoGraf = IF([Variacao] < 0 , [Variacao]*-1, [Variacao])
		lineageTag: 319971f8-df0c-4199-9fcd-d9359964bcf6

