table 'Indicadores Medidas Gerais'
	lineageTag: 2ccf8a54-6777-458a-95bf-46d62c0fce28

	measure Realizado =
			
			--medida original comentada por estouro de memoria do visual no power bi service
			/*
			VAR RealValorIndicador = [Valor Indicador]
			VAR RealValIndicadorMiudos = [ValorIndicadorMiudios]
			VAR RealValIndicadorDesossa = [ValorIndicadorLinhaDesossa]
			VAR RealValIndicadorCaixaria = [ValorIndicadorLinhaCaixaria]
			
			RETURN
			COALESCE(RealValorIndicador,RealValIndicadorMiudos,RealValIndicadorDesossa, RealValIndicadorCaixaria)
			*/
			
			-- nova medida para otimizar uso de memoria
			
			VAR indAbate    = SELECTEDVALUE('Indicadores Abate'[Indicador])
			VAR indMiudos   = SELECTEDVALUE('Indicadores Miudos'[IndicadorMiudos])
			VAR indDesossa  = SELECTEDVALUE('Indicadores Desossa'[IndicadorDesossa])
			VAR indCaixaria = SELECTEDVALUE('Indicadores Caixaria'[IndicadorCaixaria])
			
			RETURN
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(indDesossa),  [ValorIndicadorLinhaDesossa],
			    NOT ISBLANK(indCaixaria), [ValorIndicadorLinhaCaixaria],
			    NOT ISBLANK(indMiudos),   [ValorIndicadorMiudios],
			    NOT ISBLANK(indAbate),    [Valor Indicador],
			    BLANK()
			)
		formatString: 0.00
		lineageTag: c9ddcf30-d41c-436d-bfad-797040f258df

	measure 'Pct Aceitavel' = ```
			
			
			VAR vMeta   = [Meta Dia (linha)]
			VAR vTurno  = SELECTEDVALUE( Excel_Metas[Turno], "Diurno" )
			
			VAR vIndic =
			    COALESCE(
			        SELECTEDVALUE('Indicadores Abate'[Indicador]),
			        SELECTEDVALUE('Indicadores Miudos'[IndicadorMiudos]),
			        SELECTEDVALUE(Excel_Metas[Indicador]),
			        SELECTEDVALUE('Indicadores Desossa'[IndicadorDesossa]),
			        SELECTEDVALUE('Indicadores Caixaria'[IndicadorCaixaria])
			    )
			
			VAR vFilial = SELECTEDVALUE( DGE_EMPRESAMATRIZ[FILIAL],       SELECTEDVALUE( Excel_Metas[FILIAL] ) )
			
			VAR vPct =
			    CALCULATE(
			        MAX( Excel_Metas[%Aceitavel] ),
			        KEEPFILTERS( Excel_Metas[Indicador] = vIndic ),
			        KEEPFILTERS( Excel_Metas[FILIAL]    = vFilial ),
			        KEEPFILTERS( Excel_Metas[Turno]     = vTurno )
			    )
			
			VAR vRegra0 =
			    CALCULATE(
			        MAX( Excel_Metas[Regra] ),
			        KEEPFILTERS( Excel_Metas[Indicador] = vIndic ),
			        KEEPFILTERS( Excel_Metas[FILIAL]    = vFilial ),
			        KEEPFILTERS( Excel_Metas[Turno]     = vTurno )
			    )
			
			VAR vRegra = UPPER( TRIM( vRegra0 ) )
			RETURN
			        IF(
			        ISBLANK(vMeta) || ISBLANK(vPct),
			        BLANK(),
			        SWITCH(
			            vRegra,
			            ">", vMeta * vPct,       -- maior melhor
			            "<", vMeta * vPct,       -- menor melhor (ajuste aqui se quiser outro critério, p.ex. vMeta / vPct)
			                 vMeta * vPct
			        )
			    )
			
			```
		lineageTag: 5685394f-3284-4438-b1fd-e5d7f77ccb54

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regra (Meta)' = ```
			
			
			VAR vIndic =
			    COALESCE(
			        SELECTEDVALUE('Indicadores Abate'[Indicador]),
			        SELECTEDVALUE('Indicadores Miudos'[IndicadorMiudos]),
			        SELECTEDVALUE(Excel_Metas[Indicador]),
			        SELECTEDVALUE('Indicadores Desossa'[IndicadorDesossa]),
			        SELECTEDVALUE('Indicadores Caixaria'[IndicadorCaixaria])
			    )
			
			VAR vFilial = SELECTEDVALUE(DGE_EMPRESAMATRIZ[FILIAL])
			VAR vTurno  = SELECTEDVALUE(Excel_Metas[Turno], "Diurno")
			
			RETURN
			CALCULATE(
			    MAX(Excel_Metas[Regra]),
			    KEEPFILTERS(Excel_Metas[Indicador] = vIndic),
			    KEEPFILTERS(Excel_Metas[FILIAL]    = vFilial),
			    KEEPFILTERS(Excel_Metas[Turno]     = vTurno)
			)
			
			```
		lineageTag: 3c706fd8-6f61-4ab6-8efa-0c6dc731d96e

	measure 'Meta Dia (linha)' = ```
			
			COALESCE( [Meta Indicador], 0 )
			
			```
		lineageTag: 87cbeece-dae3-4fbc-a6d9-e85f84ee5f7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meta Indicador' = ```
			
			-- medida original comentada por problema de estouro de memoria dos visuais de matriz no power bi service
			/*
			VAR MetaDia =
			    MAX(EXCEL_METAS[VlrMeta])
			
			VAR SomaTipo1 =
			    CALCULATE(
			        SUM(EXCEL_METAS[VlrMeta]),
			        EXCEL_METAS[TipoMeta] = 1
			    )
			
			VAR MaxTipo0 =
			    CALCULATE(
			        MAX(EXCEL_METAS[VlrMeta]),
			        EXCEL_METAS[TipoMeta] = 0
			    )
			
			VAR MetaMes = COALESCE(SomaTipo1,0) + COALESCE(MaxTipo0,0)
			
			RETURN
			IF(
			    ISINSCOPE('Calendário'[Data]),
			    MetaDia,
			    MetaMes
			)
			*/
			
			-- nova medida para otimizar o uso de memoria
			
			VAR UsaDia = ISINSCOPE('Calendário'[Data])
			RETURN
			IF(
			    UsaDia,
			    MAX(EXCEL_METAS[VlrMeta]),  -- só MAX, não calcula SomaTipo1/MaxTipo0
			    VAR SomaTipo1 = CALCULATE(SUM(EXCEL_METAS[VlrMeta]), EXCEL_METAS[TipoMeta] = 1)
			    VAR MaxTipo0  = CALCULATE(MAX(EXCEL_METAS[VlrMeta]),  EXCEL_METAS[TipoMeta] = 0)
			    RETURN COALESCE(SomaTipo1, 0) + COALESCE(MaxTipo0, 0)
			)
			
			```
		formatString: 0
		lineageTag: 753b807d-c6e7-4c79-ae34-92105b6e5783

	measure 'Valor Meta' = ```
			
			[Meta Indicador]
			
			```
		formatString: 0.00
		lineageTag: 89e5e861-3c56-4ed3-a244-348e6f49ec79

	measure 'Variação (Real - Meta)' = ```
			
			VAR real = [Valor Indicador]
			VAR meta = [Meta Indicador]
			RETURN
			IF(
			    ISBLANK(real) || ISBLANK(meta),
			    BLANK(),
			    real - meta
			)
			
			```
		lineageTag: 66ad84ce-cae0-4b43-9c42-6e7733a185bb

		formatStringDefinition = ```
				VAR ind = SELECTEDVALUE ( 'Indicadores Abate'[Indicador] )
				RETURN
				SWITCH (
				    TRUE(),
				
				    -- Cabeças Abatidas → inteiro sem casas
				    ind = "Cabeças Abatidas", "#,##0",
				
				    -- Indicadores percentuais (começam com %)
				    LEFT(ind,1) = "%", "0.00%",
				
				    -- Demais indicadores → 2 casas decimais
				    "#,##0.00"
				)
				
				```

	measure 'Cor Var % (Auto)' = ```
			
			//VAR VarValor = [Variação%]  -- sua medida de variação em %
			//VAR indAbate= SELECTEDVALUE('Indicadores Abate'[Indicador])
			//VAR indMiudos = SELECTEDVALUE('Indicadores Miudos'[IndicadorMiudos])
			//VAR IndDesossa =  SELECTEDVALUE('Indicadores Desossa'[IndicadorDesossa])
			//VAR rawInd = COALESCE(indAbate, indMiudos, IndDesossa)
			//Var Ind = IF(ISBLANK(rawInd), BLANK(), UPPER(TRIM(rawInd)))
			//VAR IndicadorAtual = Ind
			
			/* Normaliza o texto para facilitar a detecção "contém Absenteísmo":
			//   - lowercase
			//   - remove acentos usados em "Absenteísmo" (í, ê)
			//*/
			//VAR IndicadorNorm_1 = LOWER ( IndicadorAtual )
			//VAR IndicadorNorm_2 = SUBSTITUTE ( IndicadorNorm_1, "í", "i" )
			//VAR IndicadorNorm_3 = SUBSTITUTE ( IndicadorNorm_2, "ê", "e" )
			//VAR IndicadorNorm   = IndicadorNorm_3
			
			///* True se o nome do indicador (já normalizado) contiver "absenteismo" */
			//VAR EhAbsenteismo =
			//    NOT ISBLANK ( IndicadorAtual )
			//        && CONTAINSSTRING ( IndicadorNorm, "absenteismo" )
			//
			//RETURN
			//SWITCH (
			//    TRUE(),
			//    ISBLANK ( VarValor ), "#A3A3A3",                  -- neutro (sem valor)
			//    VarValor = 0,            "#A3A3A3",               -- neutro (zero)
			//
			//    /* --- EXCEÇÃO: qualquer indicador que contenha "Absenteísmo" --- */
			//    EhAbsenteismo && VarValor > 0, "#D13438",          -- positivo = vermelho (piorou)
			//    EhAbsenteismo && VarValor < 0, "#107C10",          -- negativo = verde (melhorou)
			//
			//    /* --- Regras normais para os demais --- */
			//    VarValor > 0,             "#107C10",               -- positivo = verde
			//    VarValor < 0,             "#D13438",               -- negativo = vermelho
			//
			//    "#A3A3A3"
			//)
			
			VAR V = [Variação%]
			
			VAR VEff =
			    IF (
			        MAX ( EXCEL_METAS[Regra] ) = "MENOR",
			        -V,
			        V
			    )
			
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK ( VEff ) || VEff = 0, "#A3A3A3",
			    VEff > 0, "#107C10",
			    VEff < 0, "#D13438",
			    "#A3A3A3"
			)
			
			```
		lineageTag: 413b0c35-44c8-4c52-ba7c-52303d78ce9a

	measure 'Cor Velocimetro' = ```
			
			VAR Azul  = "#0078D4"
			VAR Verm  = "#D13438"
			VAR Cinza = "#D9D9D9"
			
			-- resolve o Realizado para abate ou miúdos
			VAR vReal =
			    COALESCE( [Valor Indicador], [ValorIndicadorMiudios] , [Valor Indicador Deossa])
			
			-- resolve a Meta (usa a MESMA meta independente do indicador)
			VAR vMeta = [Meta Dia (linha)]
			
			-- resolve aceitável
			VAR vAceit = [Pct Aceitavel]
			
			VAR vRegra =
			    UPPER( TRIM( [Regra (Meta)] ) )
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(vReal) || ISBLANK(vMeta) || ISBLANK(vAceit), Cinza,
			
			    vRegra = "MAIOR",
			        IF( vReal >= vMeta || vReal >= vAceit, Azul, Verm ),
			
			    vRegra = "MENOR",
			        IF( vReal <= vMeta || vReal <= vAceit, Azul, Verm ),
			
			    IF( vReal >= vMeta || vReal >= vAceit, Azul, Verm )
			)
			
			```
		lineageTag: 14bea89e-04e3-4c36-a163-111eb0d7568f

