	measure 'Status Var % (Num)' = ```
			
			VAR V = [Variação%]
			RETURN
			IF (
			    ISBLANK(V),
			    0,
			    SIGN (
			        IF (
			            MAX ( EXCEL_METAS[Regra] ) = "MENOR",
			            -V,
			            V
			        )
			    )
			)
			
			```
