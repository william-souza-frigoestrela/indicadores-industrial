	partition DEPARAINDUS = m
		mode: import
		queryGroup: 'Fluxo Industrial'
		source =
				let
				    Fonte = PowerPlatform.Dataflows(null),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8" = Workspaces{[workspaceId="d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"]}[Data],
				    #"316346b5-24e3-456e-b119-0fe7250fa321" = #"d4ef89a7-ada8-479b-82d8-dbaa8e7aede8"{[dataflowId="316346b5-24e3-456e-b119-0fe7250fa321"]}[Data],
				
				    // Novas fontes
				    MTZ = #"316346b5-24e3-456e-b119-0fe7250fa321"{[entity="DINVPB_ENTRADAINDUS_MTZ", version=""]}[Data],
				    SLG = #"316346b5-24e3-456e-b119-0fe7250fa321"{[entity="DINVPB_ENTRADAINDUS_SLG", version=""]}[Data],
				
				    // Combina as tabelas
				    TabelasUnidas = Table.Combine({MTZ, SLG})
				in
				    TabelasUnidas

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

