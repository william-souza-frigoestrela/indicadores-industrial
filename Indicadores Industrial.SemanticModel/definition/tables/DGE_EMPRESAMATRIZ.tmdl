	column _TipoFilial = ```
			
			SWITCH(
			TRUE(),
			    VALUE(DGE_EMPRESAMATRIZ[FILIAL]) IN {2,12}, "Bovino",
			    VALUE(DGE_EMPRESAMATRIZ[FILIAL]) IN {18,27} , "CD",   
			    VALUE(DGE_EMPRESAMATRIZ[FILIAL]) = 105 , "Fab.Ração",   
			    VALUE(DGE_EMPRESAMATRIZ[FILIAL]) = 72 , "Graxaria",
			    VALUE(DGE_EMPRESAMATRIZ[FILIAL]) IN {4,104},"Suino",
			    VALUE(DGE_EMPRESAMATRIZ[FILIAL]) IN {83,77}, "Fazenda")
			```
