	partition DGE_EMPRESAMATRIZ-c51f9abb-e95a-43df-b384-6b669a117145 = m
		mode: import
		source =
				let
				    Fonte = Oracle.Database("datavale", [HierarchicalNavigation=true, Query="Select distinct R.NROEMPRESA,
				                E.NOMEREDUZIDO as NOMEMATRIZ,
				                R.FILIAL,
				                M.NOMEREDUZIDO as NOMEFILIAL
				  From DATAVALE.DCTVPB_RAZAO R
				  LEFT JOIN DATAVALE.DGEPB_EMPRESA E
				    ON R.NROEMPRESA = E.NROEMPRESA
				  LEFT JOIN DATAVALE.DGEPB_EMPRESA M
				    ON R.FILIAL = M.NROEMPRESA
				
				"]),
				    #"Duplicatas Removidas" = Table.Distinct(Fonte, {"FILIAL"})
				in
				    #"Duplicatas Removidas"

